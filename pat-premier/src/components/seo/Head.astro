---
import { Font, getImage } from 'astro:assets';
import { ALLOW_INDEXING } from 'astro:env/server';
import { getMedia } from '@/data/media';
import { organisationSchema, pageTitle } from '@/lib/seo';
import type { ImageMetadata } from 'astro';

export interface SeoProps {
  title?: string;
  description: string;
  /** Open Graph image (defaults to the homepage hero). */
  image?: ImageMetadata;
  /** Exclude this page from search (utility and demo pages). */
  noindex?: boolean;
  /** Extra JSON-LD blocks. */
  schema?: object[];
  type?: 'website' | 'article';
}

const { title, description, image, noindex = false, schema = [], type = 'website' } = Astro.props as SeoProps;
const site = Astro.site ?? new URL('http://localhost:4321');
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', site).href;
const fullTitle = pageTitle(title);
const og = await getImage({ src: image ?? getMedia('slateReroof').src, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const ogUrl = new URL(og.src, site).href;
const robots = ALLOW_INDEXING && !noindex ? 'index, follow, max-image-preview:large' : 'noindex, nofollow';
const ld = [organisationSchema(site), ...schema];
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={robots} />
<meta name="theme-color" content="#0b1f4d" />
<meta name="format-detection" content="telephone=no" />

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />

<meta property="og:type" content={type} />
<meta property="og:locale" content="en_IE" />
<meta property="og:site_name" content="Pat Premier Roofing and Building" />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />

<Font cssVariable="--pp-font-display" preload />
<Font cssVariable="--pp-font-body" preload />

{ld.map((block) => <script type="application/ld+json" set:html={JSON.stringify(block)} />)}
