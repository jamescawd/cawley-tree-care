---
import Logo from '@/components/ui/Logo.astro';
import Icon from '@/components/ui/Icon.astro';
import SocialLinks from '@/components/ui/SocialLinks.astro';
import { business, mailHref, telHref } from '@/config/business';
import { QUOTE_HREF } from '@/config/navigation';
import { buildingServices, interiorServices, roofingServices, serviceUrl } from '@/data/services';
import { landingPages, landingUrl } from '@/data/regions';

const year = new Date().getFullYear();
---

<footer class="surface-dark relative overflow-hidden">
  <div class="wrap pt-[clamp(4rem,8vw,7rem)]">
    <div class="grid gap-10 border-b border-white/15 pb-14 lg:grid-cols-12 lg:items-end">
      <p class="font-display text-[clamp(2.1rem,1.2rem+3.6vw,4.75rem)] font-[600] leading-[0.98] tracking-[-0.03em] text-white [font-stretch:112%] lg:col-span-8">
        Built on Trust,<br /><span class="text-royal-300">Covered in Quality.</span>
      </p>
      <p class="text-[0.95rem] lg:col-span-4 lg:text-right">
        Roofing and building across Leinster, Munster and the Midlands.<br class="hidden lg:block" />
        <a href={QUOTE_HREF} class="link mt-3 inline-block" data-track="quote">Request a free quote</a>
      </p>
    </div>

    <div class="grid gap-12 py-14 sm:grid-cols-2 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <Logo on="dark" width={240} class="h-auto w-[220px]" />
        <p class="mt-6 max-w-sm text-[0.95rem] leading-relaxed">
          Roofing and building for homes and commercial properties across Leinster, Munster and the Midlands. Nationwide enquiries welcome.
        </p>
        <ul class="mt-6 space-y-2 text-[0.95rem]">
          <li><a href={telHref} class="inline-flex items-center gap-2.5 text-white hover:text-royal-300" data-track="call"><Icon name="phone" size={17} />{business.phone.display}</a></li>
          <li><a href={mailHref} class="inline-flex items-center gap-2.5 text-white hover:text-royal-300"><Icon name="mail" size={17} />{business.email}</a></li>
        </ul>
        <p class="mt-8 text-[0.8125rem] font-semibold uppercase tracking-[0.14em] text-royal-300">Watch our work</p>
        <SocialLinks variant="pill" tone="dark" class="mt-3" />
      </div>
      <nav aria-labelledby="f-roof" class="lg:col-span-2">
        <h2 id="f-roof" class="footer-h">Roofing</h2>
        <ul class="footer-list">
          {roofingServices.map((s) => <li><a href={serviceUrl(s)}>{s.short}</a></li>)}
        </ul>
      </nav>
      <nav aria-labelledby="f-build" class="lg:col-span-2">
        <h2 id="f-build" class="footer-h">Building</h2>
        <ul class="footer-list">
          {buildingServices.map((s) => <li><a href={serviceUrl(s)}>{s.short}</a></li>)}
        </ul>
        <h2 class="footer-h mt-8">Interiors</h2>
        <ul class="footer-list">
          {interiorServices.map((s) => <li><a href={serviceUrl(s)}>{s.short}</a></li>)}
        </ul>
        <h2 class="footer-h mt-8">Company</h2>
        <ul class="footer-list">
          <li><a href="/projects">Our Projects</a></li>
          <li><a href="/about">About Us</a></li>
          <li><a href="/quote">Request a Quote</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </nav>
      <nav aria-labelledby="f-areas" class="lg:col-span-4">
        <h2 id="f-areas" class="footer-h">Areas we cover</h2>
        <ul class="footer-list">
          {landingPages.map((p) => <li><a href={landingUrl(p.slug)}>{p.trade === 'roofing' ? 'Roofing' : 'Building'} Contractors {p.region.replace('the ', '')}</a></li>)}
          <li><a href="/areas">All areas we cover</a></li>
        </ul>
      </nav>
    </div>

    <div class="flex flex-col gap-4 border-t border-white/15 py-8 text-[0.8125rem] sm:flex-row sm:items-start sm:justify-between">
      <p>© {year} {business.name}. All rights reserved.</p>
      <p><a href="/privacy" class="text-white underline underline-offset-4">Privacy notice</a></p>
    </div>
  </div>
</footer>

<style>
  .footer-h {
    font-family: var(--font-sans);
    font-stretch: 100%;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-royal-300);
  }
  .footer-list {
    margin-top: 1.1rem;
    display: grid;
    gap: 0.6rem;
    font-size: 0.95rem;
  }
  .footer-list a {
    color: var(--color-on-dark);
    text-decoration: none;
    transition: color 0.2s;
  }
  .footer-list a:hover {
    color: var(--color-white);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
</style>
