---
import Photo from '@/components/ui/Photo.astro';
import Icon from '@/components/ui/Icon.astro';
import { business, telHref } from '@/config/business';
import { QUOTE_HREF } from '@/config/navigation';

/**
 * Phones: the job photo fills the screen behind the headline (portrait photos
 * suit this perfectly). Desktop: navy text panel with the photo as a
 * full-height column on the right and a second job as an inset.
 */
---

<section class="hero surface-dark relative isolate overflow-hidden" aria-labelledby="hero-h">
  <div class="hero-media absolute inset-y-0 right-0 -z-20 w-full lg:w-[44%]">
    <Photo
      media="slateReroof"
      eager
      class="h-full"
      imgClass="hero-img"
      sizes="(min-width: 64rem) 44vw, 100vw"
      widths={[480, 720, 900]}
    />
    <p class="hero-caption hidden lg:flex">
      <span class="index">Our work</span>
      Re-slating in progress: new slate on the right, old roof coming off on the left
    </p>
  </div>
  <div class="hero-shade absolute inset-0 -z-10 lg:hidden" aria-hidden="true"></div>

  <div class="wrap relative grid min-h-[calc(100svh-var(--header-h)-3.5rem)] lg:min-h-[calc(100svh-var(--header-h)-2.25rem)] lg:max-h-[58rem] lg:grid-cols-12">
    <div class="flex flex-col justify-end pb-10 pt-40 lg:col-span-7 lg:justify-center lg:py-20 lg:pr-10">
      <p class="eyebrow hero-in" style="--d:0.05s">Roofing · Building · Interiors</p>
      <h1 id="hero-h" class="t-hero hero-in mt-6" style="--d:0.15s">
        Quality Roofing &amp; Building Services <span class="text-royal-300">Across Ireland</span>
      </h1>
      <p class="t-lead hero-in mt-7 max-w-[36rem] text-on-dark" style="--d:0.3s">
        Professional roofing and building solutions for residential and commercial properties throughout Leinster, Munster and the Midlands.
      </p>
      <div class="hero-in mt-9 flex flex-col gap-3 sm:flex-row" style="--d:0.42s">
        <a href={QUOTE_HREF} class="btn btn-light" data-track="quote">Request a Free Quote <Icon name="arrow" size={18} /></a>
        <a href={telHref} class="btn btn-ghost-light" data-track="call"><Icon name="phone" size={18} /> Call {business.phone.display}</a>
      </div>

      <ul class="hero-in mt-12 grid gap-y-3 border-t border-white/20 pt-6 text-[0.875rem] text-on-dark sm:grid-cols-3 sm:gap-x-6" style="--d:0.55s">
        <li class="flex items-center gap-2.5"><Icon name="pin" size={17} class="text-royal-300" />Leinster, Munster &amp; Midlands</li>
        <li class="flex items-center gap-2.5"><Icon name="check" size={17} class="text-royal-300" />Homes &amp; businesses</li>
        <li class="flex items-center gap-2.5"><Icon name="check" size={17} class="text-royal-300" />Free quotations</li>
      </ul>
    </div>

    <div class="relative hidden lg:col-span-5 lg:block">
      <Photo
        media="flatRoofFinished"
        class="hero-inset absolute -left-24 bottom-16 aspect-[4/5] w-[46%] border-[6px] border-navy-950"
        sizes="14vw"
        widths={[300, 450, 600]}
      />
    </div>
  </div>
</section>

<style>
  .hero :global(.hero-img) {
    object-position: 60% 55%;
  }
  .hero-shade {
    background: linear-gradient(
      180deg,
      rgb(6 18 41 / 0.55) 0%,
      rgb(6 18 41 / 0.72) 28%,
      rgb(6 18 41 / 0.9) 55%,
      rgb(6 18 41 / 0.97) 100%
    );
  }
  .hero-caption {
    position: absolute;
    left: 1.5rem;
    right: 1.5rem;
    bottom: 1.5rem;
    flex-direction: column;
    gap: 0.25rem;
    max-width: 22rem;
    margin-left: auto;
    padding: 0.85rem 1rem;
    background: color-mix(in oklab, var(--color-navy-950) 82%, transparent);
    color: var(--color-white);
    font-size: 0.85rem;
    line-height: 1.4;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero :global(.hero-img) {
      animation: hero-settle 2.4s var(--ease-premium) both;
    }
    .hero-in {
      animation: hero-rise 1.1s var(--ease-premium) both;
      animation-delay: var(--d, 0s);
    }
  }
  @keyframes hero-settle {
    from {
      transform: scale(1.06);
    }
  }
  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(22px);
    }
  }
</style>
