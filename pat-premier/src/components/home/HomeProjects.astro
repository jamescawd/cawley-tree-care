---
import { getCollection } from 'astro:content';
import ProjectCard from '@/components/sections/ProjectCard.astro';

const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = all.filter((p) => p.data.featured).slice(0, 3);
const allDemo = featured.every((p) => p.data.demo);
const [first, ...rest] = featured;
---

{
  first && (
    <section class="section surface-dark" aria-labelledby="projects-h">
      <div class="wrap">
        <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-7" data-reveal>
            <p class="eyebrow">Our projects</p>
            <h2 id="projects-h" class="t-d1 mt-5">
              Work that speaks
              <br class="hidden sm:block" /> for itself
            </h2>
          </div>
          <div class="lg:col-span-4 lg:col-start-9" data-reveal>
            {allDemo ? (
              <p class="text-on-dark">
                Photographs of Pat Premier’s own completed projects are being prepared. Until then, these demonstration projects show how each job will be presented.
              </p>
            ) : (
              <p class="text-on-dark">A selection of recent roofing, building and interior projects, photographed on the job.</p>
            )}
            <a href="/projects" class="link mt-6 inline-block">
              View all projects
            </a>
          </div>
        </div>

        <div class="mt-14 grid gap-12 lg:mt-20 lg:grid-cols-12 lg:gap-8">
          <div class="lg:col-span-7" data-reveal>
            <ProjectCard project={first} size="large" index={1} />
          </div>
          <div class="grid gap-12 lg:col-span-5 lg:gap-10">
            {rest.map((p, i) => (
              <div data-reveal style={`--reveal-delay:${(i + 1) * 0.08}s`}>
                <ProjectCard project={p} size="small" index={i + 2} />
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  )
}
