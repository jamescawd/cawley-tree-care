---
/** Line icons (1.75 stroke, currentColor). Decorative unless `label` is set. */
const paths = {
  arrow: 'M4 12h15M13 6l6 6-6 6',
  'arrow-up-right': 'M7 17 17 7M8.5 7H17v8.5',
  phone:
    'M5.2 3.5h3.2l1.6 4-2.1 1.4a11.5 11.5 0 0 0 5.2 5.2l1.4-2.1 4 1.6v3.2a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 3.2 5.7a2 2 0 0 1 2-2.2Z',
  mail: 'M3.5 6.5h17v11h-17zM3.8 7l8.2 6.2L20.2 7',
  pin: 'M12 21s-6.5-6-6.5-11a6.5 6.5 0 0 1 13 0c0 5-6.5 11-6.5 11Zm0-8.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z',
  check: 'M4.5 12.5l5 5 10-11',
  plus: 'M12 5v14M5 12h14',
  menu: 'M3.5 7.5h17M3.5 12h17M3.5 16.5h17',
  close: 'M6 6l12 12M18 6 6 18',
  chevron: 'M6 9l6 6 6-6',
  clock: 'M12 7v5l3 2M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Z',
  upload: 'M12 16V4M7 9l5-5 5 5M4.5 15v4.5h15V15',
} as const;

interface Props {
  name: keyof typeof paths;
  size?: number;
  label?: string;
  class?: string;
}
const { name, size = 20, label, class: cls } = Astro.props;
const klass = [`i-${name}`, cls].filter(Boolean).join(' ');
---

<svg
  class={klass}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"><path d={paths[name]}></path></svg
>
