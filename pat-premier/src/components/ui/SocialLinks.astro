---
import { business } from '@/config/business';

/**
 * Facebook and TikTok links (brand glyphs, filled). Opens in a new tab.
 * `variant="pill"` shows labelled buttons; `variant="icon"` shows round icons.
 */
interface Props {
  variant?: 'icon' | 'pill';
  tone?: 'light' | 'dark';
  class?: string;
}
const { variant = 'icon', tone = 'light', class: cls } = Astro.props;
const links = [
  {
    name: 'TikTok',
    label: `Watch our videos on TikTok (${business.social.tiktokHandle})`,
    text: 'TikTok',
    href: business.social.tiktok,
    d: 'M16.6 5.8a4.3 4.3 0 0 1-1-2.8h-3.2v12.6a2.6 2.6 0 1 1-1.9-2.5V9.8a5.8 5.8 0 1 0 5.1 5.8V9.3a7.5 7.5 0 0 0 4.4 1.4V7.5a4.3 4.3 0 0 1-3.4-1.7Z',
  },
  {
    name: 'Facebook',
    label: 'Follow Pat Premier on Facebook',
    text: 'Facebook',
    href: business.social.facebook,
    d: 'M13.5 21v-7.5H16l.4-3h-2.9V8.6c0-.9.3-1.5 1.5-1.5h1.5V4.4a20 20 0 0 0-2.2-.1c-2.2 0-3.7 1.3-3.7 3.8v2.4H8.1v3h2.5V21h2.9Z',
  },
].filter((l) => l.href);
---

<ul class:list={['flex flex-wrap items-center gap-2.5', cls]}>
  {
    links.map((l) => (
      <li>
        <a
          href={l.href}
          target="_blank"
          rel="noopener me"
          aria-label={variant === 'icon' ? l.label : undefined}
          class:list={[
            'social',
            variant === 'pill' ? 'social-pill' : 'social-icon',
            tone === 'dark' ? 'is-dark' : 'is-light',
          ]}
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
            <path d={l.d} />
          </svg>
          {variant === 'pill' && (
            <span>
              {l.text}
              <span class="sr-only"> (opens in a new tab)</span>
            </span>
          )}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .social {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    border: 1px solid var(--color-line-strong);
    color: var(--color-ink);
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    transition:
      background-color 0.25s,
      color 0.25s,
      border-color 0.25s;
  }
  .social-icon {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
  }
  .social-pill {
    min-height: 2.75rem;
    padding: 0.5rem 1.1rem;
    border-radius: 2px;
  }
  .social:hover {
    background: var(--color-navy-900);
    border-color: var(--color-navy-900);
    color: var(--color-white);
  }
  .social.is-dark {
    border-color: color-mix(in oklab, var(--color-white) 30%, transparent);
    color: var(--color-white);
  }
  .social.is-dark:hover {
    background: var(--color-white);
    color: var(--color-ink);
  }
</style>
