---
import Icon from '@/components/ui/Icon.astro';
import { business, telHref } from '@/config/business';

interface Props {
  faqs: { q: string; a: string }[];
  heading?: string;
  eyebrow?: string;
  id?: string;
}
const { faqs, heading = 'Frequently asked questions', eyebrow = 'FAQ', id = 'faq' } = Astro.props;
---

<section class="section" aria-labelledby={`${id}-h`}>
  <div class="wrap grid gap-12 lg:grid-cols-12">
    <div class="lg:col-span-4" data-reveal>
      <p class="eyebrow">{eyebrow}</p>
      <h2 id={`${id}-h`} class="t-d2 mt-5">{heading}</h2>
      <p class="mt-5 max-w-sm text-muted">
        Something else you would like to know? Call <a href={telHref} class="link">{business.phone.display}</a>.
      </p>
    </div>
    <div class="lg:col-span-8" data-reveal>
      {
        faqs.map((f) => (
          <details class="faq group border-b border-line first:border-t">
            <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-6 text-[1.0625rem] font-semibold text-ink sm:text-lg">
              {f.q}
              <span class="mt-0.5 grid size-8 shrink-0 place-items-center rounded-full border border-line text-royal-600 transition-transform duration-300 group-open:rotate-45">
                <Icon name="plus" size={18} />
              </span>
            </summary>
            <p class="max-w-3xl pb-7 pr-12 text-body">{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq summary::-webkit-details-marker {
    display: none;
  }
</style>
