---
import type { CollectionEntry } from 'astro:content';
import Photo from '@/components/ui/Photo.astro';
import Icon from '@/components/ui/Icon.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  size?: 'large' | 'medium' | 'small';
  index?: number;
  sizes?: string;
}
const { project, size = 'medium', index, sizes } = Astro.props;
const d = project.data;
const ratio = size === 'small' ? 'aspect-[4/3]' : 'aspect-[4/5]';
---

<article class="project-card group relative">
  <a href={`/projects/${project.id}`} class="block">
    <Photo
      src={d.cover.src}
      alt={d.cover.alt}
      demo={d.demo}
      hideTag
      class={`${ratio} w-full`}
      imgClass="transition-transform duration-[1.2s] ease-(--ease-premium) group-hover:scale-[1.035]"
      sizes={sizes ?? (size === 'large' ? '(min-width: 64rem) 58vw, 100vw' : '(min-width: 64rem) 34vw, 100vw')}
    >
      {d.demo && <span class="demo-tag">Demonstration project</span>}
    </Photo>
    <div class="mt-5 flex items-start justify-between gap-6">
      <div>
        <p class="text-[0.8125rem] font-semibold uppercase tracking-[0.14em] text-royal-600">
          {index !== undefined && <span class="mr-2">{String(index).padStart(2, '0')}</span>}
          {d.workType}
        </p>
        <h3 class:list={['mt-2', size === 'large' ? 't-d3' : 'text-xl font-[620] leading-tight']}>{d.title}</h3>
        <p class="mt-1.5 text-sm text-muted">{d.location ?? d.summary}</p>
      </div>
      <span class="mt-1 grid size-11 shrink-0 place-items-center rounded-full border border-line text-ink transition-colors duration-300 group-hover:border-navy-900 group-hover:bg-navy-900 group-hover:text-white">
        <Icon name="arrow-up-right" size={18} />
      </span>
    </div>
  </a>
</article>
