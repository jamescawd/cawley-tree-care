---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ServiceHero from '@/components/service/ServiceHero.astro';
import Photo from '@/components/ui/Photo.astro';
import Icon from '@/components/ui/Icon.astro';
import Coverage from '@/components/service/Coverage.astro';
import Faq from '@/components/sections/Faq.astro';
import CtaBand from '@/components/sections/CtaBand.astro';
import { getMedia, type MediaKey } from '@/data/media';
import { serviceUrl, type Service, type LandingSlug } from '@/data/services';
import { breadcrumbSchema } from '@/lib/seo';

interface Props {
  category: 'roofing' | 'building';
  title: string;
  metaTitle: string;
  description: string;
  eyebrow: string;
  intro: string;
  image: MediaKey;
  statement: string;
  services: Service[];
  landing: LandingSlug[];
  faqs: { q: string; a: string }[];
}
const p = Astro.props;
const site = Astro.site ?? new URL('http://localhost:4321');
const name = p.category === 'roofing' ? 'Roofing' : 'Building';
const trail = [
  { name: 'Home', href: '/' },
  { name, href: `/${p.category}` },
];
---

<BaseLayout title={p.metaTitle} description={p.description} image={getMedia(p.image).src} schema={[breadcrumbSchema(site, trail)]}>
  <ServiceHero layout={p.category === 'roofing' ? 'full' : 'framed'} eyebrow={p.eyebrow} title={p.title} intro={p.intro} image={p.image} trail={trail} quoteHref="/contact#quote" />

  <section class="section" aria-labelledby="hub-intro">
    <div class="wrap grid gap-10 lg:grid-cols-12">
      <h2 id="hub-intro" class="sr-only">About our {name.toLowerCase()} services</h2>
      <p class="eyebrow lg:col-span-3" data-reveal>{name} services</p>
      <p class="t-statement lg:col-span-9" data-reveal>{p.statement}</p>
    </div>
  </section>

  <section class="pb-(--section)" aria-label={`${name} services`}>
    <div class="wrap">
      <ul class="grid gap-x-8 gap-y-16 md:grid-cols-2">
        {
          p.services.map((s, i) => (
            <li class:list={[i % 2 === 1 && 'md:mt-24']} data-reveal>
              <a href={serviceUrl(s)} class="group block">
                <Photo media={s.hero.image} class={i % 3 === 0 ? 'aspect-[4/5]' : 'aspect-[5/4]'} imgClass="transition-transform duration-[1.2s] ease-(--ease-premium) group-hover:scale-[1.035]" sizes="(min-width: 48rem) 46vw, 100vw" />
                <div class="mt-6 grid grid-cols-[3rem_1fr_auto] gap-3 border-t border-line pt-5">
                  <span class="index pt-1.5">{String(i + 1).padStart(2, '0')}</span>
                  <div>
                    <h3 class="t-d3">{s.name}</h3>
                    <p class="mt-2 max-w-md text-muted">{s.summary}</p>
                  </div>
                  <span class="grid size-11 place-items-center rounded-full border border-line text-ink transition-colors duration-300 group-hover:border-navy-900 group-hover:bg-navy-900 group-hover:text-white">
                    <Icon name="arrow" size={18} />
                  </span>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <div class="surface-paper"><Faq faqs={p.faqs} heading={`${name} questions`} /></div>
  <div class="pt-(--section)"><Coverage serviceName={name} landing={p.landing} /></div>
  <CtaBand image={p.category === 'roofing' ? 'rooferRidge' : 'extensionTimber'} />
</BaseLayout>
