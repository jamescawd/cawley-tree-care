---
import Photo from '@/components/ui/Photo.astro';
import type { MediaKey } from '@/data/media';

/** Portrait-first gallery: a staggered row of four frames (2×2 on phones). */
interface Props {
  images: MediaKey[];
  heading: string;
}
const { images, heading } = Astro.props;
---

<section class="section" aria-labelledby="gallery-h">
  <div class="wrap">
    <div class="flex flex-wrap items-end justify-between gap-4" data-reveal>
      <div>
        <p class="eyebrow">Photographs</p>
        <h2 id="gallery-h" class="t-d2 mt-5">{heading}</h2>
      </div>
      <a href="/projects" class="link">See our projects</a>
    </div>
    <div class="mt-12 grid grid-cols-2 gap-3 pb-6 sm:gap-4 lg:grid-cols-4 lg:pb-12">
      {
        images.slice(0, 4).map((key, i) => (
          <Photo
            media={key}
            class:list={['aspect-[4/5]', i % 2 === 1 && 'translate-y-6 lg:translate-y-12']}
            sizes="(min-width: 64rem) 23vw, 50vw"
            widths={[360, 540, 720, 1080]}
          />
        ))
      }
    </div>
  </div>
</section>
