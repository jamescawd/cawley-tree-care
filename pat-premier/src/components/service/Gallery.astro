---
import Photo from '@/components/ui/Photo.astro';
import type { MediaKey } from '@/data/media';

interface Props {
  images: MediaKey[];
  heading: string;
}
const { images, heading } = Astro.props;
const [a, b, c, d] = images;
---

<section class="section" aria-labelledby="gallery-h">
  <div class="wrap">
    <div class="flex flex-wrap items-end justify-between gap-4" data-reveal>
      <div>
        <p class="eyebrow">Photographs</p>
        <h2 id="gallery-h" class="t-d2 mt-5">{heading}</h2>
      </div>
      <a href="/projects" class="link">See our projects</a>
    </div>
    <div class="mt-12 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-12 lg:auto-rows-[clamp(14rem,21vw,21rem)]">
      {a && <Photo media={a} class="col-span-2 aspect-[4/3] lg:col-span-7 lg:row-span-2 lg:aspect-auto lg:h-full" sizes="(min-width: 64rem) 56vw, 100vw" />}
      {b && <Photo media={b} class="aspect-square lg:col-span-5 lg:aspect-auto lg:h-full" sizes="(min-width: 64rem) 40vw, 50vw" />}
      {c && <Photo media={c} class="aspect-square lg:col-span-3 lg:aspect-auto lg:h-full" sizes="(min-width: 64rem) 24vw, 50vw" />}
      {d && <Photo media={d} class="col-span-2 aspect-[16/9] lg:col-span-2 lg:aspect-auto lg:h-full" sizes="(min-width: 64rem) 16vw, 100vw" />}
    </div>
  </div>
</section>
