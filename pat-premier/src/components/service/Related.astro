---
import Photo from '@/components/ui/Photo.astro';
import Icon from '@/components/ui/Icon.astro';
import { getService, serviceUrl, type ServiceSlug } from '@/data/services';

interface Props {
  slugs: ServiceSlug[];
  heading?: string;
}
const { slugs, heading = 'Related services' } = Astro.props;
const list = slugs.map(getService);
---

<section class="section surface-paper" aria-labelledby="related-h">
  <div class="wrap">
    <p class="eyebrow" data-reveal>Explore</p>
    <h2 id="related-h" class="t-d2 mt-5" data-reveal>{heading}</h2>
    <ul class="mt-12 grid gap-8 md:grid-cols-3">
      {
        list.map((s) => (
          <li data-reveal>
            <a href={serviceUrl(s)} class="group block bg-white">
              <Photo media={s.hero.image} class="aspect-[16/10]" imgClass="transition-transform duration-[1.2s] ease-(--ease-premium) group-hover:scale-[1.04]" sizes="(min-width: 48rem) 31vw, 100vw" />
              <div class="flex items-start justify-between gap-4 p-6">
                <div>
                  <p class="text-[0.75rem] font-semibold uppercase tracking-[0.14em] text-royal-600">{s.category}</p>
                  <h3 class="mt-1.5 text-xl font-semibold text-ink">{s.name}</h3>
                  <p class="mt-1.5 text-muted">{s.summary}</p>
                </div>
                <Icon name="arrow" size={20} class="mt-1 shrink-0 text-royal-600 transition-transform duration-300 group-hover:translate-x-1" />
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
