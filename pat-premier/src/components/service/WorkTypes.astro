---
import type { Service } from '@/data/services';

interface Props {
  work: Service['work'];
}
const { work } = Astro.props;
const n = (i: number) => String(i + 1).padStart(2, '0');
---

<section class="section surface-paper" aria-labelledby="work-h">
  <div class="wrap">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end" data-reveal>
      <div class="lg:col-span-7">
        <p class="eyebrow">Types of work</p>
        <h2 id="work-h" class="t-d2 mt-5">{work.heading}</h2>
      </div>
      <p class="text-lg text-muted lg:col-span-4 lg:col-start-9">{work.intro}</p>
    </div>

    {
      work.layout === 'rows' && (
        <ol class="mt-14 border-t border-line">
          {work.items.map((it, i) => (
            <li class="grid gap-3 border-b border-line py-7 sm:grid-cols-12 sm:gap-6" data-reveal>
              <span class="index sm:col-span-1 sm:pt-1.5">{n(i)}</span>
              <h3 class="t-d3 sm:col-span-5">{it.title}</h3>
              <p class="text-body sm:col-span-6 sm:pt-1">{it.text}</p>
            </li>
          ))}
        </ol>
      )
    }

    {
      work.layout === 'grid' && (
        <ul class="mt-14 grid gap-px overflow-hidden border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
          {work.items.map((it, i) => (
            <li class="group relative bg-white p-7 transition-colors duration-300 hover:bg-navy-950 sm:p-9" data-reveal>
              <span class="index group-hover:text-royal-300">{n(i)}</span>
              <h3 class="mt-10 text-xl font-semibold text-ink transition-colors group-hover:text-white">{it.title}</h3>
              <p class="mt-3 text-body transition-colors group-hover:text-on-dark-muted">{it.text}</p>
            </li>
          ))}
        </ul>
      )
    }

    {
      work.layout === 'columns' && (
        <ul class="mt-14 grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
          {work.items.map((it, i) => (
            <li class="border-t-2 border-navy-900 pt-6" data-reveal style={`--reveal-delay:${(i % 3) * 0.06}s`}>
              <span class="index">{n(i)}</span>
              <h3 class="mt-3 text-xl font-semibold text-ink">{it.title}</h3>
              <p class="mt-2.5 text-body">{it.text}</p>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>
