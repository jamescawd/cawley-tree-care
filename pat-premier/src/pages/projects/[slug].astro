---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import Photo from '@/components/ui/Photo.astro';
import Icon from '@/components/ui/Icon.astro';
import BeforeAfter from '@/components/sections/BeforeAfter.astro';
import ProjectCard from '@/components/sections/ProjectCard.astro';
import { getService, serviceUrl } from '@/data/services';
import { business, telHref } from '@/config/business';
import { breadcrumbSchema } from '@/lib/seo';

export async function getStaticPaths() {
  const all = await getCollection('projects');
  return all.map((project) => ({ params: { slug: project.id }, props: { project, all } }));
}
const { project, all } = Astro.props as {
  project: CollectionEntry<'projects'>;
  all: CollectionEntry<'projects'>[];
};
const d = project.data;
const { Content } = await render(project);
const site = Astro.site ?? new URL('http://localhost:4321');
const trail = [
  { name: 'Home', href: '/' },
  { name: 'Our Projects', href: '/projects' },
  { name: d.title, href: `/projects/${project.id}` },
];
const services = d.services.map(getService);
// The cover is already shown at the top, so it is not repeated below.
const notCover = (ph: { src: { src: string } }) => ph.src.src !== d.cover.src.src;
const stages = [
  { id: 'before', title: 'Before', photos: d.before.filter(notCover) },
  { id: 'during', title: 'During the work', photos: d.during.filter(notCover) },
  { id: 'after', title: 'Completed', photos: d.after.filter(notCover) },
].filter((s) => s.photos.length && !(d.compare && s.id !== 'during'));
const others = all
  .filter((p) => p.id !== project.id && p.data.category === d.category)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
const quoteHref = `/quote?service=${encodeURIComponent(services[0]?.name ?? '')}`;
---

<BaseLayout
  title={`${d.title}${d.location ? `, ${d.location}` : ''} | Our Projects`}
  description={d.summary}
  image={d.cover.src}
  noindex={d.demo}
  type="article"
  schema={[breadcrumbSchema(site, trail)]}
>
  <section class="border-b border-line" aria-labelledby="page-h">
    <div class="wrap grid gap-10 pb-14 pt-10 lg:grid-cols-12 lg:gap-12 lg:pb-20 lg:pt-14">
      <div class="flex flex-col lg:col-span-6">
        <Breadcrumbs trail={trail} />
        <div class="mt-10 lg:mt-auto lg:pt-16">
          <p class="eyebrow">{d.workType}</p>
          <h1 id="page-h" class="t-d1 mt-5">{d.title}</h1>
          <p class="t-lead mt-6 max-w-xl text-muted">{d.summary}</p>
          <dl class="mt-10 grid gap-6 border-t border-line pt-6 sm:grid-cols-2">
            {
              d.location && (
                <div>
                  <dt class="index">Location</dt>
                  <dd class="mt-1.5 flex items-center gap-2 font-semibold text-ink">
                    <Icon name="pin" size={17} class="text-royal-600" />
                    {d.location}
                  </dd>
                </div>
              )
            }
            <div>
              <dt class="index">Type of work</dt>
              <dd class="mt-1.5 font-semibold text-ink">{d.workType}</dd>
            </div>
            <div>
              <dt class="index">Services</dt>
              <dd class="mt-1.5">
                <ul class="space-y-1">
                  {services.map((s) => <li><a href={serviceUrl(s)} class="link">{s.name}</a></li>)}
                </ul>
              </dd>
            </div>
            {
              d.completed && (
                <div>
                  <dt class="index">Completed</dt>
                  <dd class="mt-1.5 font-semibold text-ink">{d.completed}</dd>
                </div>
              )
            }
          </dl>
        </div>
      </div>
      <div class="lg:col-span-5 lg:col-start-8">
        <Photo
          src={d.cover.src}
          alt={d.cover.alt}
          demo={d.demo}
          eager
          class="aspect-[4/5]"
          sizes="(min-width: 64rem) 38vw, 100vw"
          widths={[480, 720, 960, 1200]}
        />
      </div>
    </div>
  </section>

  <section class="section" aria-label="About this project">
    <div class="wrap-narrow prose-pp text-lg">
      <Content />
    </div>
  </section>

  {
    d.compare && d.before[0] && d.after[0] && (
      <section class="section surface-paper" aria-labelledby="ba-h">
        <div class="wrap grid gap-10 lg:grid-cols-12 lg:items-center">
          <div class="lg:col-span-5">
            <p class="eyebrow">Compare</p>
            <h2 id="ba-h" class="t-d2 mt-5">Before and after</h2>
            <p class="mt-5 max-w-md text-muted">Drag the handle, or use the arrow keys, to compare the roof before and after.</p>
          </div>
          <div class="w-full max-w-lg lg:col-span-6 lg:col-start-7">
            <BeforeAfter before={d.before[0]} after={d.after[0]} demo={d.demo} />
          </div>
        </div>
      </section>
    )
  }

  {
    d.video && (
      <section class="section" aria-labelledby="video-h">
        <div class="wrap grid gap-10 lg:grid-cols-12 lg:items-center">
          <div class="lg:col-span-5">
            <p class="eyebrow">Video</p>
            <h2 id="video-h" class="t-d2 mt-5">Watch the job</h2>
            <p class="mt-5 max-w-md text-muted">
              More videos like this on TikTok ({business.social.tiktokHandle}) and Facebook.
            </p>
            <a href={business.social.tiktok} target="_blank" rel="noopener" class="btn btn-outline mt-7">
              Watch on TikTok <Icon name="arrow-up-right" size={18} />
            </a>
          </div>
          <div class="w-full max-w-xs lg:col-span-4 lg:col-start-8">
            <div class="overflow-hidden rounded-[1.25rem] border-[6px] border-navy-950 bg-navy-950">
              <video
                controls
                playsinline
                preload="none"
                poster={d.video.replace(/\.mp4$/, '.webp')}
                width="480"
                height="854"
                class="block aspect-[9/16] h-auto w-full object-cover"
                aria-label={`Video: ${d.title}`}
              >
                <source src={d.video} type="video/mp4" />
              </video>
            </div>
          </div>
        </div>
      </section>
    )
  }

  {
    stages.map((st, si) => (
      <section class:list={['section', si % 2 === 1 && 'surface-paper']} aria-labelledby={`st-${st.id}`}>
        <div class="wrap">
          <div class="flex items-baseline gap-4 border-b border-line pb-5">
            <span class="index">{String(si + 1).padStart(2, '0')}</span>
            <h2 id={`st-${st.id}`} class="t-d3">{st.title}</h2>
            <span class="ml-auto text-sm text-muted">
              {st.photos.length} photograph{st.photos.length > 1 ? 's' : ''}
            </span>
          </div>
          <div class="mt-8 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-3">
            {st.photos.map((ph, i) => (
              <Photo
                src={ph.src}
                alt={ph.alt}
                demo={d.demo}
                class:list={['aspect-[4/5]', st.photos.length === 1 && 'col-span-2 lg:col-span-1', i % 3 === 1 && 'lg:translate-y-8']}
                sizes="(min-width: 64rem) 30vw, 50vw"
                widths={[360, 540, 720, 1080]}
              />
            ))}
          </div>
        </div>
      </section>
    ))
  }

  <section class="section pt-0" aria-label="Get a quote">
    <div class="wrap">
      <div class="flex flex-col gap-6 border-t border-line pt-12 sm:flex-row sm:items-center sm:justify-between">
        <p class="t-d3 max-w-xl">Want something similar done? Quotations are free.</p>
        <div class="flex flex-col gap-3 sm:flex-row">
          <a href={quoteHref} class="btn" data-track="quote">Request a Quote <Icon name="arrow" size={18} /></a>
          <a href={telHref} class="btn btn-outline" data-track="call"><Icon name="phone" size={18} /> {business.phone.display}</a>
        </div>
      </div>
    </div>
  </section>

  {
    others.length > 0 && (
      <section class="section surface-paper" aria-labelledby="more-h">
        <div class="wrap">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <h2 id="more-h" class="t-d2">More {d.category} projects</h2>
            <a href="/projects" class="link">All projects</a>
          </div>
          <div class="mt-12 grid gap-10 md:grid-cols-3">
            {others.map((p) => <ProjectCard project={p} size="medium" sizes="(min-width: 48rem) 30vw, 100vw" />)}
          </div>
        </div>
      </section>
    )
  }

</BaseLayout>
