---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import Photo from '@/components/ui/Photo.astro';
import Icon from '@/components/ui/Icon.astro';
import BeforeAfter from '@/components/sections/BeforeAfter.astro';
import ProjectCard from '@/components/sections/ProjectCard.astro';
import CtaBand from '@/components/sections/CtaBand.astro';
import { getService, serviceUrl } from '@/data/services';
import { breadcrumbSchema } from '@/lib/seo';

export async function getStaticPaths() {
  const all = await getCollection('projects');
  return all.map((project) => ({ params: { slug: project.id }, props: { project, all } }));
}
const { project, all } = Astro.props as { project: CollectionEntry<'projects'>; all: CollectionEntry<'projects'>[] };
const d = project.data;
const { Content } = await render(project);
const site = Astro.site ?? new URL('http://localhost:4321');
const trail = [
  { name: 'Home', href: '/' },
  { name: 'Our Projects', href: '/projects' },
  { name: d.title, href: `/projects/${project.id}` },
];
const services = d.services.map(getService);
const stages = [
  { id: 'before', title: 'Before', photos: d.before },
  { id: 'during', title: 'During the work', photos: d.during },
  { id: 'after', title: 'Completed', photos: d.after },
].filter((s) => s.photos.length);
const others = all.filter((p) => p.id !== project.id).sort((a, b) => a.data.order - b.data.order).slice(0, 2);
---

<BaseLayout
  title={`${d.title}${d.demo ? ' (demonstration)' : `, ${d.location}`}`}
  description={d.summary}
  image={d.cover.src}
  noindex={d.demo}
  type="article"
  schema={[breadcrumbSchema(site, trail)]}
>
  {
    d.demo && (
      <div class="bg-royal-100 text-ink">
        <p class="wrap py-3 text-sm">
          <strong>Demonstration project.</strong> Built from stock photographs to show the layout. This is not a Pat Premier job.
        </p>
      </div>
    )
  }
  <section aria-labelledby="page-h">
    <div class="wrap pt-10 lg:pt-14">
      <Breadcrumbs trail={trail} />
      <div class="mt-10 grid gap-8 lg:mt-14 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-8">
          <p class="eyebrow">{d.workType}</p>
          <h1 id="page-h" class="t-d1 mt-5">{d.title}</h1>
        </div>
        <p class="flex items-center gap-2.5 text-lg text-muted lg:col-span-4 lg:justify-end">
          <Icon name="pin" size={19} class="text-royal-600" />{d.location}
        </p>
      </div>
    </div>
    <div class="wrap mt-10 lg:mt-14">
      <Photo src={d.cover.src} alt={d.cover.alt} demo={d.demo} eager class="aspect-[4/3] sm:aspect-[16/8]" sizes="(min-width: 90rem) 86rem, 100vw" />
    </div>
  </section>

  <section class="section" aria-label="About this project">
    <div class="wrap grid gap-12 lg:grid-cols-12">
      <dl class="grid content-start gap-6 border-t border-line pt-6 sm:grid-cols-2 lg:col-span-4 lg:grid-cols-1">
        <div>
          <dt class="index">Location</dt>
          <dd class="mt-1.5 font-semibold text-ink">{d.location}</dd>
        </div>
        <div>
          <dt class="index">Type of work</dt>
          <dd class="mt-1.5 font-semibold text-ink">{d.workType}</dd>
        </div>
        <div>
          <dt class="index">Services</dt>
          <dd class="mt-1.5">
            <ul class="space-y-1">
              {services.map((s) => <li><a href={serviceUrl(s)} class="link">{s.name}</a></li>)}
            </ul>
          </dd>
        </div>
        {d.completed && (
          <div>
            <dt class="index">Completed</dt>
            <dd class="mt-1.5 font-semibold text-ink">{d.completed}</dd>
          </div>
        )}
      </dl>
      <div class="prose-pp max-w-2xl text-lg lg:col-span-7 lg:col-start-6">
        <Content />
      </div>
    </div>
  </section>

  {
    d.before[0] && d.after[0] && (
      <section class="section surface-paper" aria-labelledby="ba-h">
        <div class="wrap">
          <p class="eyebrow">Compare</p>
          <h2 id="ba-h" class="t-d2 mt-5">Before and after</h2>
          <div class="mt-10">
            <BeforeAfter before={d.before[0]} after={d.after[0]} demo={d.demo} />
          </div>
        </div>
      </section>
    )
  }

  {
    stages.map((st, si) => (
      <section class="section" aria-labelledby={`st-${st.id}`}>
        <div class="wrap">
          <div class="flex items-baseline gap-4 border-b border-line pb-5">
            <span class="index">{String(si + 1).padStart(2, '0')}</span>
            <h2 id={`st-${st.id}`} class="t-d3">{st.title}</h2>
            <span class="ml-auto text-sm text-muted">{st.photos.length} photograph{st.photos.length > 1 ? 's' : ''}</span>
          </div>
          <div class:list={['mt-8 grid gap-4', st.photos.length === 1 ? '' : 'sm:grid-cols-2', st.photos.length >= 3 && 'lg:grid-cols-3']}>
            {st.photos.map((ph, i) => (
              <Photo
                src={ph.src}
                alt={ph.alt}
                demo={d.demo}
                class:list={[st.photos.length === 1 ? 'aspect-[16/9] lg:w-2/3' : 'aspect-[4/3]', st.photos.length >= 3 && i === 0 && 'lg:col-span-2 lg:row-span-2 lg:aspect-auto lg:h-full']}
                sizes="(min-width: 64rem) 45vw, 100vw"
              />
            ))}
          </div>
        </div>
      </section>
    ))
  }

  {
    others.length > 0 && (
      <section class="section surface-paper" aria-labelledby="more-h">
        <div class="wrap">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <h2 id="more-h" class="t-d2">More projects</h2>
            <a href="/projects" class="link">All projects</a>
          </div>
          <div class="mt-12 grid gap-10 md:grid-cols-2">
            {others.map((p) => <ProjectCard project={p} size="small" sizes="(min-width: 48rem) 46vw, 100vw" />)}
          </div>
        </div>
      </section>
    )
  }

  <CtaBand heading="Have a similar project in mind?" image={d.demo ? 'slateHouseSunset' : 'rooferRidge'} />
</BaseLayout>
