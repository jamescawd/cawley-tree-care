---
/**
 * Site header: wordmark, primary navigation, phone and quote CTA.
 * Sticky on every screen size. The mobile menu uses the native Popover API:
 * keyboard and Escape support, light-dismiss and top-layer stacking with no
 * framework JavaScript. A few lines close it after an in-page link is used.
 */
import Wordmark from '@/components/ui/Wordmark.astro';
import Button from '@/components/ui/Button.astro';
import PhoneLink from '@/components/ui/PhoneLink.astro';
import { navHref, quoteHref } from '@/config/navigation';
import { getNavigation } from '@/lib/navigation';
import { business } from '@/config/business';

const primaryNav = await getNavigation();
---

<header class="site-header surface-dark">
  <div class="container site-header__inner">
    <Wordmark />

    <nav class="site-nav" aria-label="Primary">
      <ul role="list">
        {primaryNav.map((item) => (
          <li>
            <a href={navHref(item)}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="site-header__actions">
      <PhoneLink class="site-header__phone" />
      <Button href={quoteHref} class="site-header__quote">
        Request a quote
      </Button>
      <button class="menu-toggle" type="button" popovertarget="mobile-menu" aria-label="Open menu">
        <span class="menu-toggle__lines" aria-hidden="true"></span>
        <span class="menu-toggle__label">Menu</span>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="mobile-menu surface-dark" popover>
    <div class="mobile-menu__top">
      <Wordmark />
      <button
        class="menu-close"
        type="button"
        popovertarget="mobile-menu"
        popovertargetaction="hide"
        aria-label="Close menu"
      >
        Close
      </button>
    </div>
    <nav aria-label="Mobile">
      <ul role="list" class="mobile-menu__list">
        {primaryNav.map((item) => (
          <li>
            <a href={navHref(item)}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="mobile-menu__footer">
      <Button href={quoteHref} size="lg" arrow>
        Request a quote
      </Button>
      <PhoneLink class="mobile-menu__phone" prefix="Call" />
      <p class="mobile-menu__trust">
        {business.experience.label} · {business.insurance.label}
      </p>
    </div>
  </div>
</header>

<script>
  // Close the mobile menu once an in-page link is chosen.
  const menu = document.getElementById('mobile-menu');
  menu?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) menu.hidePopover();
  });
</script>

<style>
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: var(--z-header);
    border-block-end: 1px solid var(--color-border);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
    min-height: 4.5rem;
  }

  .site-nav {
    display: none;
  }

  .site-nav ul {
    display: flex;
    gap: clamp(1.25rem, 0.5rem + 1.5vw, 2.25rem);
  }

  .site-nav a,
  .mobile-menu__list a {
    text-decoration: none;
  }

  .site-nav a {
    position: relative;
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    padding-block: 0.5rem;
  }

  .site-nav a::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0.2rem;
    height: 1px;
    background: var(--color-accent-decorative);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--duration-base) var(--ease-out);
  }

  .site-nav a:hover::after {
    transform: scaleX(1);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-s);
  }

  .site-header__actions :global(.site-header__phone) {
    display: none;
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    text-decoration: none;
    white-space: nowrap;
  }

  .site-header__actions :global(.site-header__quote) {
    display: none;
  }

  .menu-toggle,
  .menu-close {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: var(--tap-target);
    padding-inline: 0.9rem;
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-text);
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  .menu-toggle__lines {
    position: relative;
    width: 1.1rem;
    height: 1px;
    background: currentColor;
  }

  .menu-toggle__lines::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: -5px;
    width: 1.1rem;
    height: 1px;
    background: currentColor;
  }

  .menu-toggle__lines::after {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 5px;
    width: 0.7rem;
    height: 1px;
    background: var(--color-accent-decorative);
  }

  @media (min-width: 40em) {
    .site-header__actions :global(.site-header__quote) {
      display: inline-flex;
    }
  }

  @media (min-width: 64em) {
    .site-nav {
      display: block;
    }

    .site-header__actions :global(.site-header__phone) {
      display: inline;
    }

    .menu-toggle {
      display: none;
    }
  }

  /* ---- Mobile menu (popover, top layer) ---- */
  .mobile-menu {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: var(--space-s) var(--gutter) var(--space-l);
    border: 0;
    flex-direction: column;
    gap: var(--space-xl);
    overflow-y: auto;
  }

  .mobile-menu:popover-open {
    display: flex;
    animation: menu-in var(--duration-base) var(--ease-out);
  }

  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-0.5rem);
    }
  }

  .mobile-menu__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 3.5rem;
  }

  .mobile-menu__list {
    display: grid;
    border-block-start: 1px solid var(--color-border);
  }

  .mobile-menu__list a {
    display: block;
    padding-block: var(--space-xs);
    font-family: var(--font-serif);
    font-size: var(--text-3xl);
    line-height: 1.1;
    border-block-end: 1px solid var(--color-border);
  }

  .mobile-menu__footer {
    display: grid;
    gap: var(--space-s);
    justify-items: start;
    margin-block-start: auto;
  }

  .mobile-menu__footer :global(.mobile-menu__phone) {
    font-weight: var(--weight-medium);
  }

  .mobile-menu__trust {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }
</style>
