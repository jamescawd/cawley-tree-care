---
/**
 * Sticky call bar on phones (under 768px), on every page through PageLayout:
 * "Call now" (main button, a tel: link counted as a call conversion by
 * ConsentManager) and "Free quote". Hidden from 768px, where the header shows
 * the Call and quote buttons. Steps aside while the quote form is on screen
 * and while the cookie banner is open (the banner takes its place).
 */
import Button from '@/components/ui/Button.astro';
import { business } from '@/config/business';
import { provided } from '@/lib/placeholder';
import { quoteHref } from '@/config/navigation';

const { quoteLink = quoteHref } = Astro.props as { quoteLink?: string | undefined };
const phone = provided(business.contact.phone);
---

<div class="action-bar surface-dark" role="region" aria-label="Quick contact">
  {phone && (
    <Button href={`tel:${phone.replace(/[^\d+]/g, '')}`} size="lg" class="action-bar__call">
      <svg class="action-bar__icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z" />
      </svg>
      Call now
    </Button>
  )}
  <Button href={quoteLink} variant="secondary" size="lg" class="action-bar__quote">
    Free quote
  </Button>
</div>

<script>
  // Out of the way while a quote form is on screen, so it never covers the
  // fields or the Send button.
  const bar = document.querySelector<HTMLElement>('.action-bar');
  const forms = [...document.querySelectorAll('form[action="/api/quote"]')];
  if (bar && forms.length && 'IntersectionObserver' in window) {
    const visible = new Set<Element>();
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) visible.add(e.target);
        else visible.delete(e.target);
      }
      bar.toggleAttribute('data-hidden', visible.size > 0);
    });
    for (const f of forms) io.observe(f);
  }
</script>

<style>
  .action-bar {
    position: fixed;
    inset-inline: 0;
    inset-block-end: 0;
    z-index: var(--z-header);
    display: flex;
    gap: var(--space-2xs);
    padding: var(--space-2xs) var(--gutter)
      calc(var(--space-2xs) + env(safe-area-inset-bottom, 0px));
    background-color: rgb(23 23 23 / 0.96);
    border-block-start: 1px solid var(--color-border);
    transition: transform var(--duration-base) var(--ease-out);
  }

  .action-bar__icon {
    width: 1.1em;
    height: 1.1em;
    fill: currentColor;
  }

  .action-bar :global(.btn) {
    flex: 1;
    min-width: 0;
    justify-content: center;
    padding-inline: 1em;
  }

  .action-bar :global(.btn > span) {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    white-space: nowrap;
  }

  @media (max-width: 23.49em) {
    .action-bar :global(.btn) {
      font-size: var(--text-sm);
      padding-inline: 0.8em;
    }
  }

  .action-bar[data-hidden] {
    transform: translateY(110%);
  }

  /* While the cookie banner is open it sits here instead. */
  :global(body:has(.consent:not([hidden]))) .action-bar {
    display: none;
  }

  /* Keep the bar from covering the end of the page (footer, buttons). */
  :global(body:has(.action-bar)) {
    padding-block-end: calc(4.5rem + env(safe-area-inset-bottom, 0px));
  }

  @media (min-width: 48em) {
    .action-bar {
      display: none;
    }

    :global(body:has(.action-bar)) {
      padding-block-end: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .action-bar {
      transition: none;
    }
  }
</style>
