---
/**
 * Persistent call-to-action bar on phones and tablets (hidden from 1200px,
 * where the header shows the quote button and phone number).
 * Shows a Call button only once a confirmed phone number exists.
 */
import Button from '@/components/ui/Button.astro';
import { business } from '@/config/business';
import { provided } from '@/lib/placeholder';
import { quoteHref } from '@/config/navigation';

const phone = provided(business.contact.phone);
---

<div class="action-bar surface-dark" role="region" aria-label="Quick contact">
  <Button href={quoteHref} size="lg" arrow class="action-bar__quote">
    Request a free quote
  </Button>
  {phone && (
    <Button href={`tel:${phone.replace(/[^\d+]/g, '')}`} variant="secondary" size="lg">
      <svg class="action-bar__icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z" />
      </svg>
      Call now
    </Button>
  )}
</div>

<script>
  // Hide the bar while the hero buttons or the quote form are on screen, so
  // it never doubles up the hero's own call/quote buttons or covers fields.
  const bar = document.querySelector<HTMLElement>('.action-bar');
  const targets = [...document.querySelectorAll('.hero__ctas, #enquiry form')];
  if (bar && targets.length && 'IntersectionObserver' in window) {
    const visible = new Set<Element>();
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) visible.add(e.target);
        else visible.delete(e.target);
      }
      bar.toggleAttribute('data-hidden', visible.size > 0);
    });
    for (const t of targets) io.observe(t);
  }
</script>

<style>
  .action-bar {
    position: fixed;
    inset-inline: 0;
    inset-block-end: 0;
    z-index: var(--z-header);
    display: flex;
    gap: var(--space-2xs);
    padding: var(--space-2xs) var(--gutter)
      calc(var(--space-2xs) + env(safe-area-inset-bottom, 0px));
    background-color: rgb(23 23 23 / 0.96);
    border-block-start: 1px solid var(--color-border);
  }

  .action-bar__icon {
    width: 1.1em;
    height: 1.1em;
    fill: currentColor;
  }

  .action-bar :global(.btn) {
    padding-inline: 1em;
  }

  .action-bar :global(.btn > span) {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    white-space: nowrap;
  }

  .action-bar :global(.action-bar__quote) {
    flex: 1;
    min-width: 0;
    justify-content: center;
  }

  @media (max-width: 23.49em) {
    .action-bar :global(.btn) {
      font-size: var(--text-sm);
      padding-inline: 0.8em;
    }

    .action-bar :global(.btn__arrow) {
      display: none;
    }
  }

  .action-bar {
    transition: transform var(--duration-base) var(--ease-out);
  }

  /* Out of the way while the quote form itself is on screen. */
  .action-bar[data-hidden] {
    transform: translateY(110%);
  }

  @media (min-width: 75em) {
    .action-bar {
      display: none;
    }
  }

  /* Keep the bar from covering the end of the page. */
  :global(body:has(.action-bar)) {
    padding-block-end: 4.5rem;
  }

  @media (min-width: 75em) {
    :global(body:has(.action-bar)) {
      padding-block-end: 0;
    }
  }
</style>
