---
/**
 * Small fixed WhatsApp chat button, bottom-right on every page.
 * Opens WhatsApp (app on phones, WhatsApp Web on computers) with a
 * pre-filled message. Under 1200px it sits just above the mobile call/quote
 * bar and drops into the corner while that bar is hidden. It steps aside
 * whenever a call link, phone number, quote button, the quote form or the
 * footer is underneath it, so it never covers them. No third-party scripts.
 */
import { business } from '@/config/business';

const { whatsapp, whatsappMessage } = business.contact;
const href = `https://wa.me/${whatsapp}?text=${encodeURIComponent(whatsappMessage)}`;
---

<a
  class="wa-button"
  href={href}
  target="_blank"
  rel="noopener"
  aria-label="Chat with us on WhatsApp (opens WhatsApp)"
>
  <svg viewBox="0 0 32 32" aria-hidden="true" focusable="false">
    <path d="M16.01 3C8.83 3 3 8.82 3 16c0 2.29.6 4.53 1.74 6.5L3 29l6.68-1.75A12.94 12.94 0 0 0 16 28.98h.01C23.18 28.98 29 23.16 29 16c0-3.47-1.35-6.73-3.8-9.18A12.9 12.9 0 0 0 16.01 3Zm0 23.79h-.01c-1.94 0-3.85-.52-5.51-1.51l-.4-.23-3.96 1.04 1.06-3.86-.26-.4A10.74 10.74 0 0 1 5.26 16c0-5.92 4.82-10.74 10.76-10.74 2.87 0 5.57 1.12 7.6 3.15a10.68 10.68 0 0 1 3.14 7.6c0 5.93-4.82 10.78-10.75 10.78Zm5.9-8.05c-.32-.16-1.9-.94-2.2-1.05-.3-.11-.51-.16-.73.16-.21.32-.83 1.05-1.02 1.27-.19.21-.38.24-.7.08-.32-.16-1.36-.5-2.59-1.6-.96-.85-1.6-1.9-1.79-2.22-.19-.32-.02-.5.14-.65.14-.14.32-.38.48-.56.16-.19.21-.32.32-.54.11-.21.05-.4-.03-.56-.08-.16-.73-1.75-1-2.4-.26-.63-.53-.54-.73-.55h-.62c-.21 0-.56.08-.86.4-.3.32-1.13 1.1-1.13 2.69s1.16 3.12 1.32 3.33c.16.21 2.28 3.48 5.52 4.88.77.33 1.37.53 1.84.68.77.25 1.48.21 2.03.13.62-.09 1.9-.78 2.17-1.53.27-.75.27-1.4.19-1.53-.08-.13-.3-.21-.62-.37Z"></path>
  </svg>
</a>

<script>
  // Step aside whenever a call link, phone number, quote button, the quote
  // form or the footer is underneath the button, so it never covers them.
  const button = document.querySelector<HTMLElement>('.wa-button');
  const protectedSelector = [
    'a[href^="tel:"]',
    'a[href$="#quote-form"]',
    '.call-card',
    '#enquiry form',
    '.site-footer',
  ].join(',');
  if (button) {
    const zones = [...document.querySelectorAll(protectedSelector)].filter(
      (el) => !el.closest('.action-bar, .mobile-menu'),
    );
    const pad = 8;
    let queued = false;
    const check = () => {
      queued = false;
      // Measure where the button sits, even while it is hidden.
      const a = button.getBoundingClientRect();
      const covers = zones.some((el) => {
        const r = el.getBoundingClientRect();
        return (
          r.width > 0 &&
          r.right > a.left - pad &&
          r.left < a.right + pad &&
          r.bottom > a.top - pad &&
          r.top < a.bottom + pad
        );
      });
      button.toggleAttribute('data-hidden', covers);
    };
    const queue = () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(check);
      }
    };
    addEventListener('scroll', queue, { passive: true });
    addEventListener('resize', queue);
    check();
  }
</script>

<style>
  .wa-button {
    position: fixed;
    z-index: var(--z-header);
    inset-inline-end: var(--gutter);
    /* Phones and tablets: just above the call/quote bar (61–73px tall). */
    inset-block-end: calc(4.75rem + env(safe-area-inset-bottom, 0px) + 0.5rem);
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    color: var(--whatsapp-glyph);
    background: var(--whatsapp-green);
    box-shadow: 0 0.35rem 1.25rem rgb(0 0 0 / 0.28);
    transition:
      transform var(--duration-base) var(--ease-out),
      opacity var(--duration-base) var(--ease-out),
      inset-block-end var(--duration-base) var(--ease-out);
  }

  .wa-button svg {
    width: 1.85rem;
    height: 1.85rem;
    fill: currentColor;
  }

  .wa-button:hover {
    transform: scale(1.06);
  }

  .wa-button:focus-visible {
    outline: 3px solid var(--orange-500);
    outline-offset: 3px;
  }

  /* When the call/quote bar slides away, drop into the corner. */
  :global(.action-bar[data-hidden]) ~ .wa-button {
    inset-block-end: calc(var(--gutter) + env(safe-area-inset-bottom, 0px));
  }

  .wa-button[data-hidden] {
    opacity: 0;
    transform: translateY(1rem);
    pointer-events: none;
    visibility: hidden;
    transition:
      opacity var(--duration-base) var(--ease-out),
      transform var(--duration-base) var(--ease-out),
      visibility 0s linear var(--duration-base);
  }

  /* Desktop: no call/quote bar, so sit in the corner. */
  @media (min-width: 75em) {
    .wa-button {
      inset-block-end: 1.5rem;
      inset-inline-end: 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wa-button {
      transition: none;
    }
  }
</style>
