---
/** Site footer: identity, credentials, navigation, areas and contact. */
import Wordmark from '@/components/ui/Wordmark.astro';
import Pending from '@/components/ui/Pending.astro';
import PhoneLink from '@/components/ui/PhoneLink.astro';
import { business } from '@/config/business';
import { serviceAreas, countyLabel } from '@/config/areas';
import { navHref } from '@/config/navigation';
import { getNavigation } from '@/lib/navigation';
import { provided } from '@/lib/placeholder';

const email = provided(business.contact.email);
const { locality, region } = business.address;
const privacy = provided(business.links.privacyPolicy);
const year = new Date().getFullYear();

const primaryNav = await getNavigation();
---

<footer class="site-footer surface-dark">
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <Wordmark />
      <p class="site-footer__statement">
        Specialist tree care and tree surgery, with landscaping, across the Midlands &amp; West of
        Ireland.
      </p>
      <ul class="site-footer__creds" role="list">
        <li>{business.experience.label}</li>
        <li>{business.insurance.label}</li>
      </ul>
    </div>

    <nav class="site-footer__col" aria-label="Footer">
      <p class="site-footer__heading">Explore</p>
      <ul role="list">
        {primaryNav.map((item) => (
          <li>
            <a href={navHref(item)}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="site-footer__col">
      <p class="site-footer__heading">Areas we serve</p>
      <ul role="list">
        {serviceAreas.map((area) => (
          <li>{countyLabel(area.county as string)}</li>
        ))}
      </ul>
    </div>

    <div class="site-footer__col">
      <p class="site-footer__heading">Contact</p>
      <address>
        <ul role="list">
          <li>
            <PhoneLink />
          </li>
          <li>
            {email ? (
              <a href={`mailto:${email}`}>{email}</a>
            ) : (
              <Pending value={business.contact.email} compact />
            )}
          </li>
          <li>
            <Pending value={locality} compact />, <Pending value={region} compact />
          </li>
        </ul>
      </address>
    </div>
  </div>

  <div class="container site-footer__base">
    <p>
      © {year} {business.tradingName}
    </p>
    <p>
      {privacy ? (
        <a href={privacy}>Privacy notice</a>
      ) : (
        <Pending value={business.links.privacyPolicy} compact />
      )}
    </p>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--space-2xl) var(--space-m);
    font-size: var(--text-sm);
  }

  .site-footer a {
    text-decoration: none;
  }

  .site-footer a:hover {
    text-decoration: underline;
    text-decoration-color: var(--color-accent-decorative);
  }

  .site-footer__grid {
    display: grid;
    gap: var(--space-xl) var(--space-l);
  }

  .site-footer__brand {
    display: grid;
    gap: var(--space-s);
    align-content: start;
  }

  .site-footer__statement {
    color: var(--color-text-secondary);
    max-width: 34ch;
  }

  .site-footer__creds {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-s);
    font-weight: var(--weight-medium);
  }

  .site-footer__creds li {
    display: flex;
    align-items: center;
    gap: 0.6em;
  }

  .site-footer__creds li::before {
    content: '';
    width: 1rem;
    height: 2px;
    background: var(--color-accent-decorative);
  }

  .site-footer__col ul {
    display: grid;
    gap: var(--space-2xs);
  }

  .site-footer__heading {
    margin-block-end: var(--space-xs);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .site-footer__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-xs) var(--space-l);
    margin-block-start: var(--space-2xl);
    padding-block-start: var(--space-m);
    border-block-start: 1px solid var(--color-border);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  @media (min-width: 40em) {
    .site-footer__grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .site-footer__brand {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 64em) {
    .site-footer__grid {
      grid-template-columns: 2fr 1fr 1fr 1.2fr;
    }

    .site-footer__brand {
      grid-column: auto;
    }
  }
</style>
