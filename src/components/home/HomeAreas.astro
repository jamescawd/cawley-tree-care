---
import SectionHeader from '@/components/ui/SectionHeader.astro';
import AreaGrid from '@/components/sections/AreaGrid.astro';
import AreaMap from '@/components/sections/AreaMap.astro';
import Button from '@/components/ui/Button.astro';
import { quoteHref } from '@/config/navigation';
---

<section
  id="areas"
  class="section-lg areas-section surface-dark texture"
  aria-labelledby="areas-title"
>
  <div class="container areas-section__inner">
    <SectionHeader id="areas-title" eyebrow="Areas we serve" size="xl" split>
      <Fragment slot="title">
        Across the <em>Midlands</em> &amp; West
      </Fragment>
      <p>
        Based in Athlone, Co. Westmeath, we work throughout five counties, including the major towns
        below. If your town isn’t listed, ask us: we may still be able to help.
      </p>
    </SectionHeader>
    <div class="areas-section__body">
      <div class="areas-section__map reveal">
        <AreaMap />
      </div>
      <AreaGrid />
    </div>
    <Button href={quoteHref} variant="secondary" arrow>
      Check we cover your area
    </Button>
  </div>
</section>

<style>
  .areas-section__inner {
    display: grid;
    gap: var(--space-xl);
    justify-items: start;
  }

  .areas-section__inner > :global(*) {
    width: 100%;
  }

  .areas-section__body {
    display: grid;
    gap: var(--space-xl);
  }

  .areas-section__body > * {
    min-width: 0;
  }

  .areas-section__map {
    max-width: 34rem;
    justify-self: center;
    width: 100%;
  }

  @media (min-width: 64em) {
    .areas-section__body {
      grid-template-columns: 5fr 7fr;
      gap: var(--space-2xl);
      align-items: start;
    }

    .areas-section__map {
      position: sticky;
      inset-block-start: calc(var(--header-height) + var(--space-l));
    }
  }

  .areas-section__inner > :global(.btn) {
    width: auto;
  }
</style>
