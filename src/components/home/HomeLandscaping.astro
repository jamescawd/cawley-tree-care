---
import SectionHeader from '@/components/ui/SectionHeader.astro';
import Button from '@/components/ui/Button.astro';
import ServiceIndex from '@/components/sections/ServiceIndex.astro';
import { landscaping } from '@/config/services';
import { quoteHref } from '@/config/navigation';
---

<section id="landscaping" class="section-lg landscaping" aria-labelledby="landscaping-title">
  <div class="container landscaping__inner">
    <SectionHeader id="landscaping-title" index="02" eyebrow="Landscaping" size="xl" split>
      <Fragment slot="title">
        Gardens &amp; grounds, <em>finished well</em>
      </Fragment>
      <p>
        The same care and standards we bring to trees, applied to the wider garden: from new
        planting and lawns to paving, boundaries and ongoing upkeep.
      </p>
    </SectionHeader>
    <ServiceIndex services={landscaping.services} variant="cards" label="Landscaping services" />
    <Button href={quoteHref} variant="secondary" arrow>
      Plan your landscaping
    </Button>
  </div>
</section>

<style>
  .landscaping__inner {
    display: grid;
    gap: var(--space-xl);
  }
</style>
