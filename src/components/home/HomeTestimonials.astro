---
/**
 * Customer reviews from src/content/testimonials (one YAML file each, so
 * they are easy to add, edit or remove). No review counts, averages or
 * platform badges are shown or added to structured data.
 */
import { getCollection } from 'astro:content';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import Button from '@/components/ui/Button.astro';
import { business } from '@/config/business';
import { quoteHref } from '@/config/navigation';
import { provided } from '@/lib/placeholder';

const reviews = (await getCollection('testimonials')).sort((a, b) => a.data.order - b.data.order);
const googleProfile = provided(business.links.googleBusinessProfile);
---

{reviews.length > 0 && (
  <section id="reviews" class="section-lg reviews" aria-labelledby="reviews-title">
    <div class="container reviews__inner">
      <SectionHeader id="reviews-title" eyebrow="Customer reviews" size="xl" split>
        <Fragment slot="title">
          In our customers’ <em>words</em>
        </Fragment>
        <p>What customers across Westmeath, Roscommon and beyond have said about our work.</p>
      </SectionHeader>

      <ul class="reviews__list" role="list">
        {reviews.map(({ data: r }) => (
          <li class="review reveal">
            <figure>
              {r.rating && (
                <p class="review__stars" role="img" aria-label={`Rated ${r.rating} out of 5`}>
                  {Array.from({ length: 5 }, (_, i) => (
                    <svg
                      viewBox="0 0 20 20"
                      aria-hidden="true"
                      class:list={{ off: i >= r.rating! }}
                    >
                      <path d="M10 1.6l2.5 5.4 5.9.6-4.4 4 1.3 5.8L10 14.5l-5.3 2.9L6 11.6l-4.4-4 5.9-.6z" />
                    </svg>
                  ))}
                </p>
              )}
              <blockquote>
                <p>{r.quote}</p>
              </blockquote>
              <figcaption>
                <span class="review__name">{r.name}</span>
                {r.location && <span class="review__place">{r.location}</span>}
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>

      <div class="reviews__cta">
        <Button href={quoteHref} size="lg" arrow>
          Request a free quote
        </Button>
        {googleProfile && (
          <Button href={googleProfile} variant="secondary" arrow target="_blank" rel="noopener">
            Read our reviews on Google
          </Button>
        )}
      </div>
    </div>
  </section>
)}

<style>
  .reviews__inner {
    display: grid;
    gap: var(--space-xl);
  }

  /* Masonry-style columns suit a mix of short and long reviews. */
  .reviews__list {
    columns: 1;
    column-gap: var(--space-l);
  }

  @media (min-width: 48em) {
    .reviews__list {
      columns: 2;
    }
  }

  @media (min-width: 72em) {
    .reviews__list {
      columns: 3;
    }
  }

  .review {
    break-inside: avoid;
    max-width: none;
    padding-block: var(--space-m);
    border-block-start: 1px solid var(--color-border);
  }

  .review figure {
    display: grid;
    gap: var(--space-xs);
    margin: 0;
  }

  .review__stars {
    display: flex;
    gap: 2px;
  }

  .review__stars svg {
    width: 0.95rem;
    height: 0.95rem;
    fill: var(--charcoal-900);
  }

  .review__stars svg.off {
    fill: var(--ivory-300);
  }

  blockquote,
  blockquote p {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    line-height: 1.5;
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.3em 0.7em;
    font-size: var(--text-sm);
  }

  .review__name {
    font-weight: var(--weight-semibold);
  }

  .review__place {
    display: inline-flex;
    align-items: center;
    gap: 0.7em;
    color: var(--color-text-secondary);
  }

  .review__place::before {
    content: '';
    width: 1rem;
    height: 1px;
    background: var(--orange-500);
  }

  .reviews__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }
</style>
