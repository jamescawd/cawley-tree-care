---
import SectionHeader from '@/components/ui/SectionHeader.astro';
import Button from '@/components/ui/Button.astro';
import ServiceIndex from '@/components/sections/ServiceIndex.astro';
import { treeCare } from '@/config/services';
import { quoteHref } from '@/config/navigation';
import { business } from '@/config/business';
---

<section
  id="tree-care"
  class="section-lg tree-care surface-dark texture"
  aria-labelledby="tree-care-title"
>
  <span class="tree-care__watermark" aria-hidden="true">
    Trees
  </span>
  <div class="container tree-care__grid">
    <div class="tree-care__intro">
      <SectionHeader id="tree-care-title" index="01" eyebrow="Our specialism" size="xl">
        <Fragment slot="title">
          Tree care &amp; <em>tree surgery</em>
        </Fragment>
        <p>
          Trees are our specialism and the core of our business. From a single garden tree to larger
          jobs, every tree is approached with care for its health, its surroundings and your
          property.
        </p>
      </SectionHeader>

      <div class="tree-care__card surface-accent reveal">
        <p class="tree-care__card-figure" aria-hidden="true">
          {business.experience.figure}
        </p>
        <div>
          <p class="tree-care__card-label">{business.experience.label}</p>
          <p class="tree-care__card-sub">{business.insurance.label}</p>
        </div>
      </div>

      <Button href={quoteHref} arrow>
        Discuss your trees
      </Button>
    </div>

    <ServiceIndex services={treeCare.services} label="Tree care services" />
  </div>
</section>

<style>
  .tree-care {
    overflow: hidden;
  }

  /* Oversized outlined word: quiet texture behind the section. */
  .tree-care__watermark {
    position: absolute;
    inset-block-end: -0.18em;
    inset-inline-end: -0.04em;
    z-index: -1;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(10rem, 4rem + 22vw, 26rem);
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px rgb(242 238 230 / 0.07);
    pointer-events: none;
    user-select: none;
  }

  .tree-care__grid {
    display: grid;
    gap: var(--space-xl);
  }

  .tree-care__grid > * {
    min-width: 0;
  }

  .tree-care__intro {
    display: grid;
    gap: var(--space-l);
    align-content: start;
    justify-items: start;
  }

  .tree-care__card {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-s) var(--space-m);
    width: 100%;
    padding: var(--space-m);
    border-radius: var(--radius-md);
  }

  .tree-care__card-figure {
    font-family: var(--font-serif);
    font-size: var(--text-5xl);
    line-height: 0.85;
    letter-spacing: var(--tracking-display);
  }

  .tree-care__card-label {
    font-weight: var(--weight-semibold);
  }

  .tree-care__card-sub {
    font-size: var(--text-sm);
  }

  @media (min-width: 64em) {
    .tree-care__grid {
      grid-template-columns: 5fr 7fr;
      gap: var(--space-3xl);
    }

    .tree-care__intro {
      position: sticky;
      inset-block-start: calc(var(--header-height) + var(--space-l));
      align-self: start;
    }
  }
</style>
