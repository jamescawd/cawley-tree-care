---
/** Featured work: the business's own jobs (config/gallery.ts). */
import SectionHeader from '@/components/ui/SectionHeader.astro';
import WorkGallery from '@/components/sections/WorkGallery.astro';
import Button from '@/components/ui/Button.astro';
import { quoteHref } from '@/config/navigation';
---

<section id="work" class="section-lg work surface-dark texture" aria-labelledby="work-title">
  <div class="container work__inner">
    <SectionHeader id="work-title" eyebrow="Featured work" size="xl" split>
      <Fragment slot="title">
        Work we’re <em>proud of</em>
      </Fragment>
      <p>Storm clear-ups, tree removals and hedge work carried out by the Cawley's team.</p>
    </SectionHeader>
    <WorkGallery />
    <Button href={quoteHref} variant="secondary" arrow>
      Discuss your project
    </Button>
  </div>
</section>

<style>
  .work__inner {
    display: grid;
    gap: var(--space-xl);
  }
</style>
