---
/** Featured work: the business's own jobs (config/gallery.ts). */
import SectionHeader from '@/components/ui/SectionHeader.astro';
import WorkGallery from '@/components/sections/WorkGallery.astro';
import Button from '@/components/ui/Button.astro';
import { quoteHref } from '@/config/navigation';
---

<section id="work" class="section-lg work" aria-labelledby="work-title">
  <div class="container work__inner">
    <SectionHeader id="work-title" eyebrow="Featured work" size="xl" split>
      <Fragment slot="title">
        Work we’re <em>proud of</em>
      </Fragment>
      <p>
        A selection of tree surgery, removals, storm clear-ups, hedge and garden work carried out by
        the Cawley's team.
      </p>
    </SectionHeader>
    <WorkGallery />
    <Button href={quoteHref} size="lg" arrow>
      Request a free quote
    </Button>
  </div>
</section>

<style>
  .work__inner {
    display: grid;
    gap: var(--space-xl);
  }

  /* Let the scrollable filter row shrink instead of widening the page. */
  .work__inner > :global(*) {
    min-width: 0;
  }
</style>
