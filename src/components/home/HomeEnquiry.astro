---
import SectionHeader from '@/components/ui/SectionHeader.astro';
import EnquiryForm from '@/components/sections/EnquiryForm.astro';
import TrustList from '@/components/ui/TrustList.astro';
import { business } from '@/config/business';
import { isPlaceholder, provided } from '@/lib/placeholder';

interface Props {
  /** Service name to pre-select in "Type of work" (service pages). */
  service?: string;
}
const { service } = Astro.props;
const email = provided(business.contact.email);
const hours = business.openingHours;
---

<section
  id="enquiry"
  class="section-lg enquiry-section surface-dark texture"
  aria-labelledby="enquiry-title"
>
  <div class="container enquiry-section__grid">
    <div class="enquiry-section__intro">
      <SectionHeader id="enquiry-title" eyebrow="Free, friendly advice" size="xl">
        <Fragment slot="title">
          Request a <em>free quote</em>
        </Fragment>
        <p>
          Not sure exactly what you need? That’s fine. Tell us a little about the job and where you
          are, or give us a call to talk it through, and we’ll take it from there.
        </p>
      </SectionHeader>

      <a class="call-card" href={`tel:${business.contact.phone}`}>
        <span class="call-card__label">Prefer to talk? Call us</span>
        <span class="call-card__number">{business.contact.phoneDisplay}</span>
      </a>

      {(email || !isPlaceholder(hours)) && (
        <dl class="contact-list">
          {email && (
            <div>
              <dt>Email</dt>
              <dd>
                <a href={`mailto:${email}`}>{email}</a>
              </dd>
            </div>
          )}
          {!isPlaceholder(hours) && (
            <div>
              <dt>Hours</dt>
              <dd>{hours.join(', ')}</dd>
            </div>
          )}
        </dl>
      )}

      <TrustList stacked />
    </div>

    <div id="quote-form" class="enquiry-section__panel surface-light">
      <EnquiryForm selected={service} />
    </div>
  </div>
</section>

<style>
  .enquiry-section__grid {
    display: grid;
    gap: var(--space-xl);
  }

  .enquiry-section__grid > * {
    min-width: 0;
  }

  .enquiry-section__intro {
    display: grid;
    gap: var(--space-l);
    align-content: start;
  }

  .call-card {
    display: grid;
    gap: var(--space-3xs);
    padding: var(--space-m);
    color: var(--charcoal-900);
    text-decoration: none;
    background: var(--orange-500);
    transition: background-color var(--duration-base) var(--ease-out);
  }

  .call-card:hover {
    background: var(--orange-400);
  }

  .call-card__label {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
  }

  .call-card__number {
    font-family: var(--font-serif);
    font-size: clamp(1.9rem, 1.2rem + 3.4vw, 3.5rem);
    white-space: nowrap;
    line-height: 1;
    font-variant-numeric: lining-nums tabular-nums;
  }

  .contact-list {
    display: grid;
    border-block-start: 1px solid var(--color-border);
  }

  .contact-list > div {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: var(--space-s);
    padding-block: var(--space-xs);
    border-block-end: 1px solid var(--color-border);
  }

  .contact-list dt {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    padding-block-start: 0.2em;
  }

  .contact-list dd {
    font-weight: var(--weight-medium);
  }

  .enquiry-section__panel {
    padding: var(--space-l) var(--space-m);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lifted);
  }

  @media (min-width: 64em) {
    .enquiry-section__grid {
      grid-template-columns: 5fr 7fr;
      gap: var(--space-3xl);
    }

    .enquiry-section__intro {
      position: sticky;
      inset-block-start: calc(4.5rem + var(--space-l));
      align-self: start;
    }

    .enquiry-section__panel {
      padding: var(--space-xl);
    }
  }
</style>
