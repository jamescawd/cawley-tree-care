---
/**
 * Cinematic hero: a genuine job photograph, full-bleed under the sticky
 * header, with the headline set over a left-and-bottom charcoal overlay.
 * Phones: the photo fills the top of the screen and the headline overlaps
 * its lower edge, so both get room.
 */
import { Picture } from 'astro:assets';
import Button from '@/components/ui/Button.astro';
import { business } from '@/config/business';
import { media } from '@/config/media';
import { quoteHref } from '@/config/navigation';
import { serviceAreas } from '@/config/areas';

const counties = serviceAreas.map((a) => a.county as string);
const countyList = `${counties.slice(0, -1).join(', ')} and ${counties.at(-1)}`;
const intro = `Tree surgery, tree removal, storm damage and hedge work, with garden clearance and landscaping, across ${countyList}.`;
const hero = media.homeHero;
const phoneHref = `tel:${business.contact.phone}`;
const widths = [480, 720, 960, hero.src.width].filter(
  (w, i, a) => w <= hero.src.width && a.indexOf(w) === i,
);
---

<section class="hero surface-dark" aria-labelledby="hero-title">
  <div class="hero__media">
    <Picture
      src={hero.src}
      alt={hero.alt}
      widths={widths}
      sizes="100vw"
      formats={['avif', 'webp']}
      priority
      layout="none"
    />
  </div>

  <div class="container hero__content">
    <p class="eyebrow hero__eyebrow">Tree Surgery · Tree Care · Landscaping</p>
    <h1 id="hero-title" class="text-display hero__title">
      Specialist tree care, <em>rooted</em> in experience.
    </h1>
    <p class="lead hero__lead">{intro}</p>
    <div class="hero__ctas">
      <Button href={quoteHref} size="lg" arrow>
        Request a free quote
      </Button>
      <Button href={phoneHref} variant="secondary" size="lg" class="hero__call">
        Call {business.contact.phoneDisplay}
      </Button>
    </div>
    <ul class="hero__trust" role="list">
      <li>{business.experience.label}</li>
      <li>{business.insurance.label}</li>
      <li>Based in Athlone, Co. Westmeath</li>
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    margin-block-start: calc(var(--header-height) * -1);
  }

  .hero__media {
    position: absolute;
    inset: 0 0 auto;
    height: 72svh;
    z-index: -1;
  }

  .hero__media :global(picture),
  .hero__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero__media :global(img) {
    object-fit: cover;
    object-position: 62% 58%;
  }

  .hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgb(17 17 17 / 0.6) 0%,
      rgb(17 17 17 / 0) 24%,
      rgb(17 17 17 / 0) 46%,
      rgb(23 23 23 / 0.88) 78%,
      var(--charcoal-900) 100%
    );
  }

  .hero__content {
    display: grid;
    gap: var(--space-s);
    padding-block: calc(54svh) var(--space-xl);
  }

  .hero__eyebrow,
  .hero__title {
    text-shadow: 0 2px 24px rgb(17 17 17 / 0.55);
  }

  .hero__title {
    max-width: 10ch;
    margin-block: var(--space-3xs) var(--space-2xs);
    font-size: clamp(2.75rem, 1.6rem + 5.2vw, 4.25rem);
  }

  .hero__lead {
    max-width: 40ch;
    color: var(--ivory-100);
  }

  .hero__ctas {
    display: grid;
    gap: var(--space-2xs);
    margin-block-start: var(--space-xs);
  }

  .hero__ctas :global(.btn) {
    justify-self: stretch;
  }

  .hero__ctas :global(.hero__call) {
    background-color: rgb(23 23 23 / 0.35);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .hero__trust {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs) var(--space-m);
    margin-block-start: var(--space-xs);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--ivory-100);
  }

  .hero__trust li {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    max-width: none;
  }

  .hero__trust li::before {
    content: '';
    width: 0.4rem;
    height: 0.4rem;
    background: var(--orange-500);
    border-radius: 50%;
  }

  @media (min-width: 30em) {
    .hero__ctas {
      grid-template-columns: auto auto;
      justify-content: start;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__media :global(img) {
      animation: hero-settle 2.8s var(--ease-out) both;
    }

    .hero__content > :global(*) {
      animation: hero-rise 1s var(--ease-out) both;
    }

    .hero__content > :global(:nth-child(2)) {
      animation-delay: 0.08s;
    }

    .hero__content > :global(:nth-child(3)) {
      animation-delay: 0.2s;
    }

    .hero__content > :global(:nth-child(4)) {
      animation-delay: 0.32s;
    }
  }

  @keyframes hero-settle {
    from {
      transform: scale(1.07);
    }
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(1.25rem);
    }
  }

  @media (min-width: 64em) {
    .hero {
      display: flex;
      align-items: flex-end;
      min-height: max(42rem, min(100svh, 62rem));
    }

    .hero__media {
      inset: 0;
      height: auto;
    }

    .hero__media :global(img) {
      object-position: 62% 60%;
    }

    .hero__media::after {
      background:
        linear-gradient(
          to right,
          rgb(17 17 17 / 0.9) 0%,
          rgb(17 17 17 / 0.62) 36%,
          rgb(17 17 17 / 0) 64%
        ),
        linear-gradient(to top, rgb(17 17 17 / 0.9) 0%, rgb(17 17 17 / 0) 36%),
        linear-gradient(to bottom, rgb(17 17 17 / 0.55) 0%, rgb(17 17 17 / 0) 18%);
    }

    .hero__content {
      width: 100%;
      padding-block: calc(var(--header-height) + var(--space-2xl)) var(--space-2xl);
    }

    .hero__title {
      font-size: clamp(4rem, 1rem + 5vw, 6.5rem);
    }

    .hero__lead {
      font-size: var(--text-xl);
    }
  }
</style>
