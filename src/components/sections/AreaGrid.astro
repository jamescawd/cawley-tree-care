---
/**
 * Service areas as an editorial index: one row per county with a large
 * serif name and its towns. Data from config/areas.ts.
 */
import { serviceAreas } from '@/config/areas';
import { provided } from '@/lib/placeholder';

const areas = serviceAreas.flatMap((a) => {
  const county = provided(a.county);
  if (!county) return [];
  return [{ id: a.id, county, towns: a.towns.map(provided).filter((t): t is string => !!t) }];
});
---

<ol class="areas" role="list">
  {areas.map((area, i) => (
    <li class="areas__row reveal">
      <span class="areas__n" aria-hidden="true">
        {String(i + 1).padStart(2, '0')}
      </span>
      <h3 class="areas__name">
        <span class="areas__co">Co.</span> {area.county}
      </h3>
      <ul class="areas__towns" role="list" aria-label={`Towns we serve in County ${area.county}`}>
        {area.towns.map((town) => (
          <li>{town}</li>
        ))}
      </ul>
    </li>
  ))}
</ol>

<style>
  .areas {
    border-block-start: 1px solid var(--color-border);
  }

  .areas__row {
    display: grid;
    grid-template-columns: 2rem 1fr;
    column-gap: var(--space-s);
    row-gap: var(--space-xs);
    padding-block: var(--space-m);
    border-block-end: 1px solid var(--color-border);
    max-width: none;
  }

  .areas__n {
    padding-block-start: 0.9em;
    font-family: var(--font-serif);
    font-size: var(--text-base);
    color: var(--color-text-muted);
  }

  .areas__name {
    font-size: var(--text-4xl);
    line-height: 1;
    letter-spacing: var(--tracking-display);
    transition: color var(--duration-base) var(--ease-out);
  }

  .areas__co {
    font-style: italic;
    color: var(--color-accent-text);
  }

  .areas__towns {
    grid-column: 2;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35em 0;
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .areas__towns li {
    max-width: none;
  }

  .areas__towns li:not(:last-child)::after {
    content: '·';
    margin-inline: 0.65em;
    color: var(--color-accent-decorative);
  }

  .areas__row:hover .areas__name {
    color: var(--color-accent-text);
  }

  @media (min-width: 64em) {
    .areas__row {
      grid-template-columns: 3rem 1fr;
      column-gap: var(--space-m);
      padding-block: var(--space-m);
    }
  }
</style>
