---
/** A real, completed project from the `projects` collection. */
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  priority?: boolean;
}

const { project, priority = false } = Astro.props;
const { title, location, coverImage, coverImageAlt, summary } = project.data;
---

<article class="project">
  <div class="project__media">
    <Picture
      src={coverImage}
      alt={coverImageAlt}
      widths={[480, 720, 960, 1280]}
      sizes="(min-width: 64em) 33vw, (min-width: 40em) 50vw, 100vw"
      formats={['avif', 'webp']}
      priority={priority}
      layout="none"
    />
  </div>
  <h3 class="project__title">{title}</h3>
  <p class="project__meta">{location}</p>
  <p class="project__summary">{summary}</p>
</article>

<style>
  .project {
    display: grid;
    gap: var(--space-2xs);
  }

  .project__media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius-md);
    margin-block-end: var(--space-xs);
  }

  .project__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .project:hover .project__media :global(img) {
    transform: scale(1.03);
  }

  .project__title {
    font-size: var(--text-xl);
  }

  .project__meta {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .project__summary {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }
</style>
