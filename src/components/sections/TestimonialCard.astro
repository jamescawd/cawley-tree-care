---
/**
 * One customer review. With `review`, shows a genuine, verified testimonial.
 * Without it, shows an explicit placeholder: never sample quotes.
 */
import type { CollectionEntry } from 'astro:content';

interface Props {
  review?: CollectionEntry<'testimonials'>['data'];
}

const { review } = Astro.props;
const sourceLabel = {
  google: 'Google review',
  facebook: 'Facebook review',
  direct: 'Customer review',
};
---

<figure class:list={['review', { 'review--placeholder': !review }]}>
  <span class="review__mark" aria-hidden="true">
    “
  </span>
  {review ? (
    <>
      <blockquote class="review__quote">
        <p>{review.quote}</p>
      </blockquote>
      <figcaption class="review__by">
        <span class="review__name">{review.name}</span>
        <span class="review__source">
          {review.sourceUrl ? (
            <a href={review.sourceUrl}>{sourceLabel[review.source]}</a>
          ) : (
            sourceLabel[review.source]
          )}
        </span>
      </figcaption>
    </>
  ) : (
    <>
      <p class="review__quote review__quote--empty">
        A genuine customer review will appear here, published with the customer’s permission.
      </p>
      <p class="review__by">
        <span class="review__name">Placeholder</span>
        <span class="review__source">Awaiting genuine review</span>
      </p>
    </>
  )}
</figure>

<style>
  .review {
    display: grid;
    gap: var(--space-s);
    align-content: start;
    margin: 0;
    padding: var(--space-l);
    background: var(--color-bg-raised);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .review--placeholder {
    background: transparent;
    border-style: dashed;
    border-color: var(--color-text-muted);
  }

  .review__mark {
    font-family: var(--font-serif);
    font-size: 4.5rem;
    line-height: 0.6;
    height: 2rem;
    color: var(--color-accent-decorative);
  }

  .review__quote,
  .review__quote p {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    line-height: 1.35;
  }

  .review__quote--empty {
    color: var(--color-text-secondary);
  }

  .review__by {
    display: grid;
    gap: 0.15em;
    padding-block-start: var(--space-s);
    border-block-start: 1px solid var(--color-border);
    font-size: var(--text-sm);
  }

  .review__name {
    font-weight: var(--weight-semibold);
  }

  .review__source {
    color: var(--color-text-muted);
  }
</style>
