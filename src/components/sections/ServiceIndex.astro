---
/**
 * Service listings in three styles:
 *  - "feature": large editorial rows (primary services); each row links to
 *    the quote form and highlights on hover/focus.
 *  - "cards":   numbered cards in a responsive grid (secondary services).
 *  - "compact": simple two-column list.
 */
import Pending from '@/components/ui/Pending.astro';
import ArrowIcon from '@/components/ui/ArrowIcon.astro';
import type { ServiceSummary } from '@/config/services';

interface Props {
  services: ServiceSummary[];
  variant?: 'feature' | 'cards' | 'compact';
  label: string;
  /** Where each "feature" row links (defaults to the quote form). */
  href?: string;
}

const { services, variant = 'feature', label, href = '/#enquiry' } = Astro.props;
const num = (i: number) => String(i + 1).padStart(2, '0');
---

<ol class:list={['services', `services--${variant}`]} role="list" aria-label={label}>
  {services.map((service, i) => (
    <li class="services__item reveal">
      {variant === 'feature' ? (
        <a class="services__link" href={href}>
          <span class="services__n" aria-hidden="true">
            {num(i)}
          </span>
          <span class="services__text">
            <span class="services__name">
              <Pending value={service.name} />
            </span>
            <span class="services__desc">
              <Pending value={service.description} compact />
            </span>
          </span>
          <span class="services__go" aria-hidden="true">
            <ArrowIcon />
          </span>
          <span class="visually-hidden">: request a quote</span>
        </a>
      ) : (
        <>
          <span class="services__n" aria-hidden="true">
            {num(i)}
          </span>
          <h3 class="services__name">
            <Pending value={service.name} />
          </h3>
          <p class="services__desc">
            <Pending value={service.description} compact />
          </p>
        </>
      )}
    </li>
  ))}
</ol>

<style>
  /* ---------- feature ---------- */
  .services--feature {
    border-block-start: 1px solid var(--color-border);
  }

  .services--feature .services__item {
    max-width: none;
    border-block-end: 1px solid var(--color-border);
  }

  .services__link {
    position: relative;
    display: grid;
    grid-template-columns: 2.5rem 1fr auto;
    align-items: center;
    gap: var(--space-s);
    padding-block: var(--space-m);
    text-decoration: none;
    color: inherit;
  }

  /* Orange rule that sweeps in on hover. */
  .services__link::before {
    content: '';
    position: absolute;
    inset-inline: 0;
    inset-block-end: -1px;
    height: 2px;
    background: var(--color-accent-decorative);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--duration-base) var(--ease-out);
  }

  .services__link:is(:hover, :focus-visible)::before {
    transform: scaleX(1);
  }

  .services--feature .services__n {
    align-self: start;
    padding-block-start: 0.6em;
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    line-height: 1;
    color: var(--color-text-muted);
    transition: color var(--duration-base) var(--ease-out);
  }

  .services__text {
    display: grid;
    gap: var(--space-3xs);
  }

  .services--feature .services__name {
    font-family: var(--font-serif);
    font-size: var(--text-3xl);
    line-height: 1.05;
    letter-spacing: var(--tracking-heading);
    transition:
      transform var(--duration-base) var(--ease-out),
      color var(--duration-base) var(--ease-out);
  }

  .services--feature .services__desc {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .services__go {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    transition:
      background-color var(--duration-base) var(--ease-out),
      border-color var(--duration-base) var(--ease-out),
      color var(--duration-base) var(--ease-out);
  }

  .services__link:is(:hover, :focus-visible) .services__name {
    transform: translateX(0.5rem);
    color: var(--color-accent-text);
  }

  .services__link:is(:hover, :focus-visible) .services__n {
    color: var(--color-accent-text);
  }

  .services__link:is(:hover, :focus-visible) .services__go {
    color: var(--button-primary-text);
    background-color: var(--button-primary-bg);
    border-color: var(--button-primary-bg);
  }

  /* ---------- cards ---------- */
  .services--cards {
    display: grid;
    gap: var(--space-s);
  }

  .services--cards .services__item {
    position: relative;
    display: grid;
    gap: var(--space-2xs);
    align-content: start;
    max-width: none;
    padding: var(--space-m);
    background: var(--color-bg-raised);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    transition:
      transform var(--duration-base) var(--ease-out),
      box-shadow var(--duration-base) var(--ease-out);
  }

  .services--cards .services__item::before {
    content: '';
    position: absolute;
    inset: -1px -1px auto;
    height: 3px;
    background: var(--color-accent-decorative);
    border-radius: var(--radius-md) var(--radius-md) 0 0;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--duration-base) var(--ease-out);
  }

  .services--cards .services__item:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lifted);
  }

  .services--cards .services__item:hover::before {
    transform: scaleX(1);
  }

  .services--cards .services__n {
    margin-block-end: var(--space-2xs);
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    line-height: 0.9;
    color: transparent;
    -webkit-text-stroke: 1px var(--color-text-muted);
  }

  .services--cards .services__name {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    line-height: 1.1;
  }

  .services--cards .services__desc {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  @media (min-width: 40em) {
    .services--cards {
      grid-template-columns: 1fr 1fr;
    }

    .services--cards .services__item {
      padding: var(--space-l) var(--space-m) var(--space-m);
    }

    .services--cards .services__n {
      margin-block-end: var(--space-s);
      font-size: var(--text-4xl);
    }
  }

  @media (min-width: 64em) {
    .services--cards {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-m);
    }
  }

  /* ---------- compact ---------- */
  .services--compact {
    border-block-start: 1px solid var(--color-border-strong);
  }

  .services--compact .services__item {
    display: grid;
    grid-template-columns: 2.25rem 1fr;
    column-gap: var(--space-s);
    row-gap: var(--space-3xs);
    padding-block: var(--space-s);
    border-block-end: 1px solid var(--color-border);
    max-width: none;
  }

  .services--compact .services__n {
    grid-row: span 2;
    font-family: var(--font-serif);
    font-size: var(--text-base);
    color: var(--color-text-muted);
  }

  .services--compact .services__name {
    font-family: var(--font-sans);
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
  }

  .services--compact .services__desc {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  @media (min-width: 48em) {
    .services--compact {
      display: grid;
      grid-template-columns: 1fr 1fr;
      column-gap: var(--space-l);
    }
  }
</style>
