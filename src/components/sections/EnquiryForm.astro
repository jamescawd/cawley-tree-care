---
/**
 * Quote enquiry form. Plain HTML: works without JavaScript, native
 * validation, autocomplete hints, ≥44px targets.
 *
 * Until `business.enquiryEndpoint` is configured, the form is shown but
 * cannot submit, with a visible notice (no personal data goes anywhere).
 */
import Button from '@/components/ui/Button.astro';
import Pending from '@/components/ui/Pending.astro';
import { business } from '@/config/business';
import { serviceAreas } from '@/config/areas';
import { provided } from '@/lib/placeholder';
import { services } from '@/config/services';

interface Props {
  id?: string;
}

const { id = 'quote-form' } = Astro.props;
const endpoint = provided(business.enquiryEndpoint);
const privacy = provided(business.links.privacyPolicy);
const workTypes = [...services.map((s) => s.name), 'Not sure yet'];
---

<form
  class="form enquiry"
  id={id}
  method="post"
  enctype="multipart/form-data"
  action={endpoint}
  aria-describedby={endpoint ? undefined : `${id}-offline`}
>
  {!endpoint && (
    <p class="enquiry__offline" id={`${id}-offline`} role="note">
      <strong>Placeholder:</strong> this form is not connected yet, so enquiries cannot be sent from
      this preview.
    </p>
  )}

  <div class="form-row">
    <div class="field">
      <label class="field__label" for={`${id}-name`}>
        Your name
      </label>
      <input class="input" id={`${id}-name`} name="name" type="text" autocomplete="name" required />
    </div>
    <div class="field">
      <label class="field__label" for={`${id}-phone`}>
        Phone number
      </label>
      <input
        class="input"
        id={`${id}-phone`}
        name="phone"
        type="tel"
        autocomplete="tel"
        inputmode="tel"
        required
      />
    </div>
  </div>

  <div class="form-row">
    <div class="field">
      <label class="field__label" for={`${id}-email`}>
        Email <span class="field__optional">(optional)</span>
      </label>
      <input class="input" id={`${id}-email`} name="email" type="email" autocomplete="email" />
    </div>
    <div class="field">
      <label class="field__label" for={`${id}-location`}>
        Where is the job?
      </label>
      <select class="select" id={`${id}-location`} name="location" required>
        <option value="">Choose a town</option>
        {serviceAreas.map((area) => (
          <optgroup label={`Co. ${area.county as string}`}>
            {area.towns.map((town) => (
              <option>{town as string}</option>
            ))}
            <option value={`Elsewhere in Co. ${area.county as string}`}>
              Elsewhere in Co. {area.county as string}
            </option>
          </optgroup>
        ))}
        <option value="Other">Somewhere else</option>
      </select>
    </div>
  </div>

  <div class="field">
    <label class="field__label" for={`${id}-service`}>
      Type of work
    </label>
    <select class="select" id={`${id}-service`} name="service" required>
      <option value="">Choose the type of work</option>
      {workTypes.map((t) => (
        <option>{t}</option>
      ))}
    </select>
  </div>

  <div class="field">
    <label class="field__label" for={`${id}-message`}>
      Tell us about the job <span class="field__optional">(optional)</span>
    </label>
    <textarea
      class="textarea"
      id={`${id}-message`}
      name="message"
      rows="5"
      aria-describedby={`${id}-message-hint`}
    ></textarea>
    <p class="field__hint" id={`${id}-message-hint`}>
      For example: the type and size of tree, what you'd like done, and any access details.
    </p>
  </div>

  <div class="field">
    <label class="field__label" for={`${id}-photos`}>
      Photos of the job <span class="field__optional">(optional)</span>
    </label>
    <input
      class="input input--file"
      id={`${id}-photos`}
      name="photos"
      type="file"
      accept="image/*"
      multiple
      aria-describedby={`${id}-photos-hint`}
    />
    <p class="field__hint" id={`${id}-photos-hint`}>
      A photo or two of the tree or hedge helps us understand the job. Up to 3 images.
    </p>
  </div>

  <input type="hidden" name="started" value="" data-started />

  <div class="form__trap" aria-hidden="true">
    <label for={`${id}-website`}>Leave this field empty</label>
    <input id={`${id}-website`} name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <div class="enquiry__submit">
    <Button type="submit" size="lg" arrow disabled={!endpoint}>
      Send my free quote request
    </Button>
    <p class="field__hint">
      We’ll be in touch to talk through the job and arrange your quote. We use your details only for
      this.{' '}
      {privacy ? (
        <a href={privacy}>Privacy notice</a>
      ) : (
        <Pending value={business.links.privacyPolicy} compact />
      )}
    </p>
  </div>
</form>

<style>
  .enquiry__offline {
    padding: var(--space-xs) var(--space-s);
    font-size: var(--text-sm);
    color: var(--color-text);
    border: 1px dashed var(--color-text-muted);
    border-radius: var(--radius-sm);
    max-width: none;
  }

  .enquiry__submit {
    display: grid;
    gap: var(--space-xs);
    justify-items: start;
  }
</style>

<script>
  // Spam check: record when the form was opened (the handler rejects
  // instant submissions). The form still works if this never runs.
  document.querySelectorAll<HTMLInputElement>('[data-started]').forEach((el) => {
    el.value = String(Date.now());
  });
</script>
