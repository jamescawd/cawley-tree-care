---
/**
 * Gallery of the business's own work, with category filters.
 * Filters are radio buttons styled as chips; CSS :has() hides other
 * categories, so no JavaScript is needed. Without :has() support, all
 * items simply stay visible.
 */
import { Picture } from 'astro:assets';
import { workCategories, workItems } from '@/config/gallery';
---

<div class="gallery">
  <fieldset class="gallery__filters">
    <legend class="visually-hidden">Show work by type</legend>
    <input
      class="visually-hidden"
      type="radio"
      name="work-filter"
      id="wf-all"
      value="all"
      checked
    />
    <label for="wf-all">All work</label>
    {workCategories.map((c) => (
      <>
        <input
          class="visually-hidden"
          type="radio"
          name="work-filter"
          id={`wf-${c.id}`}
          value={c.id}
        />
        <label for={`wf-${c.id}`}>{c.label}</label>
      </>
    ))}
  </fieldset>

  <ul class="gallery__grid" role="list">
    {workItems.map((item) => (
      <li
        class:list={['work-card', { 'work-card--pair': item.photos.length === 2 }]}
        data-cat={item.category}
      >
        <figure>
          <div class="work-card__media">
            {item.photos.map((p) => (
              <div class="work-card__photo">
                <Picture
                  src={p.src}
                  alt={p.alt}
                  widths={[400, 640, 960, 1280].filter((w) => w <= p.src.width)}
                  sizes="(min-width: 64em) 33vw, (min-width: 40em) 50vw, 100vw"
                  formats={['avif', 'webp']}
                  layout="none"
                  style={p.focus ? `object-position: ${p.focus}` : undefined}
                />
                {p.tag && <span class="work-card__tag">{p.tag}</span>}
              </div>
            ))}
          </div>
          <figcaption>{item.title}</figcaption>
        </figure>
      </li>
    ))}
  </ul>
</div>

<style>
  .gallery {
    display: grid;
    gap: var(--space-l);
  }

  .gallery__filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin: 0;
    padding: 0;
    border: 0;
  }

  .gallery__filters label {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-target);
    padding-inline: 1.1em;
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-text);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    cursor: pointer;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }

  .gallery__filters label:hover {
    border-color: var(--color-border-strong);
  }

  .gallery__filters input:checked + label {
    color: var(--button-primary-text);
    background-color: var(--button-primary-bg);
    border-color: var(--button-primary-bg);
  }

  .gallery__filters input:focus-visible + label {
    outline: var(--border-thick) solid var(--color-focus);
    outline-offset: 3px;
  }

  .gallery__grid {
    display: grid;
    grid-auto-flow: dense;
    gap: var(--space-m);
  }

  @media (min-width: 40em) {
    .gallery__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .work-card--pair {
      grid-column: span 2;
    }
  }

  @media (min-width: 64em) {
    .gallery__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Filtering (CSS only). */
  .gallery:has(#wf-storm:checked) .work-card:not([data-cat='storm']),
  .gallery:has(#wf-removal:checked) .work-card:not([data-cat='removal']),
  .gallery:has(#wf-hedges:checked) .work-card:not([data-cat='hedges']) {
    display: none;
  }

  .work-card {
    max-width: none;
  }

  .work-card figure {
    display: grid;
    gap: var(--space-2xs);
    margin: 0;
  }

  .work-card__media {
    display: grid;
    gap: var(--space-3xs);
  }

  .work-card--pair .work-card__media {
    grid-template-columns: 1fr 1fr;
  }

  .work-card__photo {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--color-bg-subtle);
  }

  .work-card--pair .work-card__photo {
    aspect-ratio: 3 / 4;
  }

  @media (min-width: 40em) {
    .work-card--pair .work-card__photo {
      aspect-ratio: 4 / 3;
    }
  }

  .work-card__photo :global(picture),
  .work-card__photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .work-card__photo :global(img) {
    object-fit: cover;
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .work-card:hover .work-card__photo :global(img) {
    transform: scale(1.03);
  }

  .work-card__tag {
    position: absolute;
    inset-block-start: var(--space-2xs);
    inset-inline-start: var(--space-2xs);
    padding: 0.3em 0.7em;
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--charcoal-900);
    background: var(--orange-500);
    border-radius: var(--radius-sm);
  }

  .work-card figcaption {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-text-secondary);
  }
</style>
