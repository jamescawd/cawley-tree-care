---
/**
 * Portfolio mosaic of the business's own work.
 * - Varied tile sizes on desktop (12-column grid); an even 2-column grid
 *   on phones. Before/after pairs show both photos side by side.
 * - Category filters are radio buttons styled as chips; CSS :has()
 *   filters the tiles, so no JavaScript is needed. Without :has()
 *   support, every tile stays visible.
 */
import { Picture } from 'astro:assets';
import { workCategories, workItems } from '@/config/gallery';

const label = Object.fromEntries(workCategories.map((c) => [c.id, c.label]));
const sizes: Record<string, string> = {
  feature: '(min-width: 64em) 33vw, 50vw',
  wide: '(min-width: 64em) 33vw, 50vw',
  tall: '(min-width: 64em) 33vw, 50vw',
  standard: '(min-width: 64em) 33vw, 50vw',
};
---

<div class="gallery">
  <fieldset class="gallery__filters">
    <legend class="visually-hidden">Show work by type</legend>
    <input
      class="visually-hidden"
      type="radio"
      name="work-filter"
      id="wf-all"
      value="all"
      checked
    />
    <label for="wf-all">All work</label>
    {workCategories.map((c) => (
      <>
        <input
          class="visually-hidden"
          type="radio"
          name="work-filter"
          id={`wf-${c.id}`}
          value={c.id}
        />
        <label for={`wf-${c.id}`}>{c.label}</label>
      </>
    ))}
  </fieldset>

  <ul class="mosaic" role="list">
    {workItems.map((item) => (
      <li
        class:list={['tile', `tile--${item.size}`, { 'tile--pair': item.photos.length === 2 }]}
        data-cat={item.category}
      >
        <figure>
          <div class="tile__media">
            {item.photos.map((p) => (
              <div class="tile__photo">
                <Picture
                  src={p.src}
                  alt={p.alt}
                  widths={[400, 640, 960, 1280].filter((w) => w <= p.src.width)}
                  sizes={sizes[item.size]}
                  formats={['avif', 'webp']}
                  layout="none"
                  style={p.focus ? `object-position: ${p.focus}` : undefined}
                />
                {p.tag && <span class="tile__tag">{p.tag}</span>}
              </div>
            ))}
          </div>
          <figcaption class="tile__caption">
            <span class="tile__cat">{label[item.category]}</span>
            <span class="tile__title">{item.title}</span>
          </figcaption>
        </figure>
      </li>
    ))}
  </ul>
</div>

<style>
  .gallery {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-l);
  }

  /* ---------- Filters ---------- */
  .gallery__filters {
    display: flex;
    gap: var(--space-2xs);
    margin: 0 calc(var(--gutter) * -1);
    padding: 0 var(--gutter) var(--space-3xs);
    border: 0;
    min-inline-size: 0; /* fieldsets default to min-content width */
    overflow-x: auto;
    scrollbar-width: none;
  }

  .gallery__filters::-webkit-scrollbar {
    display: none;
  }

  @media (min-width: 48em) {
    .gallery__filters {
      flex-wrap: wrap;
      margin: 0;
      padding: 0;
      overflow: visible;
    }
  }

  .gallery__filters label {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-target);
    padding-inline: 1.15em;
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    white-space: nowrap;
    color: var(--color-text);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  .gallery__filters label:hover {
    border-color: var(--color-border-strong);
  }

  .gallery__filters input:checked + label {
    color: var(--button-primary-text);
    background-color: var(--button-primary-bg);
    border-color: var(--button-primary-bg);
  }

  .gallery__filters input:focus-visible + label {
    outline: var(--border-thick) solid var(--color-focus);
    outline-offset: 3px;
  }

  /* ---------- Mosaic ---------- */
  .mosaic {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-rows: 9.5rem;
    grid-auto-flow: dense;
    gap: var(--space-3xs);
  }

  .tile {
    grid-row: span 2;
    max-width: none;
  }

  .tile--pair,
  .tile--feature {
    grid-column: span 2;
  }

  @media (min-width: 40em) {
    .mosaic {
      grid-auto-rows: 11rem;
    }
  }

  @media (min-width: 64em) {
    .mosaic {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-auto-rows: clamp(8rem, 9vw, 10rem);
      gap: var(--space-2xs);
    }

    .tile--feature {
      grid-column: span 8;
      grid-row: span 4;
    }

    .tile--tall {
      grid-column: span 4;
      grid-row: span 4;
    }

    .tile--wide {
      grid-column: span 8;
      grid-row: span 3;
    }

    .tile--standard {
      grid-column: span 4;
      grid-row: span 3;
    }
  }

  /* Filtered views: an even grid so no gaps appear. */
  .gallery:has(input:not(#wf-all):checked) .tile {
    grid-row: span 2;
  }

  @media (min-width: 64em) {
    .gallery:has(input:not(#wf-all):checked) .tile {
      grid-column: span 6;
      grid-row: span 3;
    }
  }

  .gallery:has(#wf-surgery:checked) .tile:not([data-cat='surgery']),
  .gallery:has(#wf-removal:checked) .tile:not([data-cat='removal']),
  .gallery:has(#wf-storm:checked) .tile:not([data-cat='storm']),
  .gallery:has(#wf-hedges:checked) .tile:not([data-cat='hedges']),
  .gallery:has(#wf-clearance:checked) .tile:not([data-cat='clearance']) {
    display: none;
  }

  /* ---------- Tile ---------- */
  .tile figure {
    position: relative;
    height: 100%;
    margin: 0;
    overflow: hidden;
    background: var(--charcoal-800);
  }

  .tile__media {
    display: grid;
    height: 100%;
    gap: 2px;
  }

  .tile--pair .tile__media {
    grid-template-columns: 1fr 1fr;
  }

  .tile__photo {
    position: relative;
    overflow: hidden;
    min-height: 0;
  }

  .tile__photo :global(picture),
  .tile__photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .tile__photo :global(img) {
    object-fit: cover;
    transition: transform 900ms var(--ease-out);
  }

  .tile:hover .tile__photo :global(img) {
    transform: scale(1.04);
  }

  .tile__tag {
    position: absolute;
    inset-block-start: var(--space-2xs);
    inset-inline-start: var(--space-2xs);
    padding: 0.3em 0.65em;
    font-size: 0.6875rem;
    font-weight: var(--weight-semibold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--charcoal-900);
    background: var(--orange-500);
  }

  .tile__caption {
    position: absolute;
    inset: auto 0 0;
    display: grid;
    gap: 0.15em;
    padding: var(--space-xl) var(--space-s) var(--space-s);
    background: linear-gradient(to top, rgb(17 17 17 / 0.88), rgb(17 17 17 / 0));
    pointer-events: none;
  }

  .tile__cat {
    font-size: 0.6875rem;
    font-weight: var(--weight-semibold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--orange-500);
  }

  .tile__title {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    line-height: 1.35;
    color: var(--ivory-100);
  }

  @media (min-width: 64em) {
    .tile--feature .tile__title,
    .tile--wide .tile__title {
      font-family: var(--font-serif);
      font-size: var(--text-xl);
      font-weight: var(--weight-regular);
    }
  }
</style>
