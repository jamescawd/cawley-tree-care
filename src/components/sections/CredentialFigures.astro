---
/** Large-figure credentials. Only ever fed confirmed facts. */
export interface Figure {
  value: string;
  /** Render the value in italic serif (for words rather than numbers). */
  word?: boolean;
  label: string;
  detail?: string;
}

interface Props {
  figures: Figure[];
}

const { figures } = Astro.props;
---

<dl class="figures">
  {figures.map((f) => (
    <div class="figures__item">
      <dt class="visually-hidden">{f.label}</dt>
      <dd class:list={['figures__value', { 'figures__value--word': f.word }]} aria-hidden="true">
        {f.value}
      </dd>
      <dd class="figures__label">{f.label}</dd>
      {f.detail && <dd class="figures__detail">{f.detail}</dd>}
    </div>
  ))}
</dl>

<style>
  .figures {
    display: grid;
    border-block-start: 1px solid var(--color-border);
  }

  .figures__item {
    display: grid;
    gap: var(--space-2xs);
    align-content: start;
    padding-block: var(--space-l);
    border-block-end: 1px solid var(--color-border);
  }

  .figures__value {
    font-family: var(--font-serif);
    font-size: var(--text-5xl);
    font-synthesis: none;
    line-height: 0.95;
    letter-spacing: var(--tracking-display);
    color: var(--color-accent-text);
  }

  .figures__value--word {
    font-style: italic;
  }

  .figures__label {
    font-weight: var(--weight-semibold);
  }

  .figures__detail {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    max-width: 30ch;
  }

  @media (min-width: 40em) {
    .figures {
      grid-template-columns: 1fr 1fr;
      column-gap: var(--space-l);
    }
  }

  @media (min-width: 64em) {
    .figures {
      grid-template-columns: repeat(4, 1fr);
      column-gap: 0;
      border-block-end: 1px solid var(--color-border);
    }

    .figures__item {
      padding-inline: var(--space-m);
      border-block-end: 0;
    }

    .figures__item:first-child {
      padding-inline-start: 0;
    }

    .figures__item + .figures__item {
      border-inline-start: 1px solid var(--color-border);
    }
  }
</style>
