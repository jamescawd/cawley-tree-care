---
/**
 * Brand logo, linking home.
 *  - "horizontal": tree mark beside the wordmark (header, mobile menu)
 *  - "stacked":    the full logo as supplied (footer, large placements)
 * Transparent versions are derived from the supplied artwork by
 * scripts/brand/make-logo-variants.py. Designed for dark surfaces.
 */
import { Image } from 'astro:assets';
import { business } from '@/config/business';
import horizontal from '@/assets/brand/logo-horizontal.png';
import stacked from '@/assets/brand/logo-stacked.png';

interface Props {
  href?: string;
  variant?: 'horizontal' | 'stacked';
  /** Load eagerly (the header logo is above the fold). */
  priority?: boolean;
}

const { href = '/', variant = 'horizontal', priority = false } = Astro.props;
const src = variant === 'stacked' ? stacked : horizontal;
// Display width in CSS px; the "fixed" layout also generates a 2x file for sharp edges.
const width = variant === 'stacked' ? 320 : 300;
---

<a class:list={['wordmark', `wordmark--${variant}`]} href={href}>
  <Image
    src={src}
    alt={business.tradingName}
    width={width}
    format="webp"
    quality={90}
    loading={priority ? 'eager' : 'lazy'}
    layout="fixed"
  />
</a>

<style>
  .wordmark {
    display: inline-flex;
    flex-shrink: 0;
    line-height: 0;
  }

  .wordmark :global(img) {
    width: auto;
    max-width: none;
  }

  /* Header lockup: 40px on the smallest phones, 44px on phones, 56px from tablet up. */
  .wordmark--horizontal :global(img) {
    height: 2.5rem;
  }

  @media (min-width: 23.5em) {
    .wordmark--horizontal :global(img) {
      height: 2.75rem;
    }
  }

  @media (min-width: 40em) {
    .wordmark--horizontal :global(img) {
      height: 3.5rem;
    }
  }

  .wordmark--stacked :global(img) {
    width: min(20rem, 100%);
    height: auto;
  }
</style>
