---
/** Phone number as a tel: link, or a visible placeholder until confirmed. */
import { business } from '@/config/business';
import { provided } from '@/lib/placeholder';
import Pending from './Pending.astro';

interface Props {
  prefix?: string;
  class?: string;
}

const { prefix, class: className } = Astro.props;
const phone = provided(business.contact.phone);
---

{phone ? (
  <a class={className} href={`tel:${phone.replace(/[^\d+]/g, '')}`}>
    {prefix && <span>{prefix} </span>}
    {phone}
  </a>
) : (
  <span class={className}>
    {prefix && <span>{prefix} </span>}
    <Pending value={business.contact.phone} compact />
  </span>
)}
