---
/**
 * Confirmed credentials, as a compact strip. Only confirmed facts are used:
 * experience, insurance and service area (all from config).
 */
import { business } from '@/config/business';
import { serviceAreas } from '@/config/areas';

interface Props {
  /** Always one item per line (for narrow columns). */
  stacked?: boolean;
  class?: string;
}
const { stacked = false, class: className } = Astro.props;
const counties = serviceAreas.length;
const words = ['zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine'];
const items = [
  business.experience.label,
  business.insurance.label,
  `Serving ${words[counties] ?? counties} counties across the Midlands & West`,
];
---

<ul
  class:list={['trust', { 'trust--stacked': stacked }, className]}
  role="list"
  aria-label="Why customers choose us"
>
  {items.map((item) => (
    <li>{item}</li>
  ))}
</ul>

<style>
  .trust {
    display: grid;
    gap: var(--space-xs);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    letter-spacing: 0.01em;
  }

  .trust li {
    display: flex;
    align-items: center;
    gap: 0.85em;
    max-width: none;
  }

  .trust li::before {
    content: '';
    flex-shrink: 0;
    width: 1.5rem;
    height: 2px;
    background: var(--color-accent-decorative);
  }

  @media (min-width: 48em) {
    .trust:not(.trust--stacked) {
      grid-auto-flow: column;
      justify-content: start;
      gap: var(--space-xl);
    }
  }
</style>
