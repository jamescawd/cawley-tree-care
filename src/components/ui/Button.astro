---
/**
 * Button / call-to-action.
 * Renders <a> when `href` is set, otherwise <button>.
 * Colours come from the surrounding surface (see tokens.css), so contrast is
 * correct on light, dark and orange surfaces without extra props.
 */
import type { HTMLAttributes } from 'astro/types';
import ArrowIcon from './ArrowIcon.astro';

type Variant = 'primary' | 'secondary' | 'text';
type Size = 'md' | 'lg';

type Props = {
  variant?: Variant;
  size?: Size;
  /** Optional trailing arrow, for "go somewhere" links. */
  arrow?: boolean;
} & (
  | ({ href: string } & Omit<HTMLAttributes<'a'>, 'href'>)
  | ({ href?: undefined } & HTMLAttributes<'button'>)
);

const { variant = 'primary', size = 'md', arrow = false, class: className, ...rest } = Astro.props;
const classes = ['btn', `btn--${variant}`, `btn--${size}`, className];
---

{'href' in rest && rest.href ? (
  <a class:list={classes} {...(rest as HTMLAttributes<'a'>)}>
    <span>
      <slot />
    </span>
    {arrow && <ArrowIcon />}
  </a>
) : (
  <button class:list={classes} type="button" {...(rest as HTMLAttributes<'button'>)}>
    <span>
      <slot />
    </span>
    {arrow && <ArrowIcon />}
  </button>
)}

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6em;
    min-height: var(--tap-target);
    padding: 0.75em 1.4em;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.01em;
    line-height: 1.2;
    text-decoration: none;
    border: var(--border-thin) solid transparent;
    border-radius: var(--radius-sm);
    transition:
      background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }

  .btn--lg {
    font-size: var(--text-base);
    padding: 0.9em 1.75em;
  }

  .btn--primary {
    color: var(--button-primary-text);
    background-color: var(--button-primary-bg);
  }

  .btn--primary:hover {
    background-color: var(--button-primary-bg-hover);
  }

  .btn--secondary {
    color: var(--button-secondary-text);
    background-color: transparent;
    border-color: var(--button-secondary-border);
  }

  .btn--secondary:hover {
    color: var(--color-bg);
    background-color: var(--button-secondary-border);
  }

  .btn--text {
    min-height: auto;
    padding: 0.25em 0;
    color: var(--color-text);
    border-radius: 0;
    border-block-end: var(--border-thick) solid var(--color-accent-decorative);
  }

  .btn--text:hover {
    border-block-end-color: currentColor;
  }

  .btn :global(.btn__arrow) {
    width: 1em;
    height: 1em;
    flex-shrink: 0;
    transition: transform var(--duration-base) var(--ease-out);
  }

  .btn:hover :global(.btn__arrow) {
    transform: translateX(3px);
  }

  .btn:disabled,
  .btn[aria-disabled='true'] {
    opacity: 0.5;
    cursor: not-allowed;
  }
</style>
