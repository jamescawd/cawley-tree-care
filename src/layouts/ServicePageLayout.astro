---
/**
 * Dedicated service page (e.g. /tree-removal). Content comes from
 * src/config/servicePages/<slug>.ts; see docs/SERVICE-PAGES.md.
 *
 * Section order (the customer journey):
 *   A hero → B introduction → C work we undertake → D why Cawley's →
 *   E photos → F how it works → G areas → H FAQs + related services →
 *   I final call to action → quote form (service pre-selected).
 *
 * Reuses the homepage system: surface classes, SectionHeader, Button,
 * TrustList, HomeAreas (map + county index) and HomeEnquiry (the working
 * quote form). Structured data: Service, BreadcrumbList and FAQPage.
 */
import { Picture, getImage } from 'astro:assets';
import PageLayout from '@/layouts/PageLayout.astro';
import Button from '@/components/ui/Button.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import TrustList from '@/components/ui/TrustList.astro';
import HomeAreas from '@/components/home/HomeAreas.astro';
import HomeEnquiry from '@/components/home/HomeEnquiry.astro';
import { breadcrumbSchema, faqSchema, serviceSchema } from '@/lib/schema';
import { business } from '@/config/business';
import { serviceById } from '@/config/services';
import { servicePages, type ServicePage } from '@/config/servicePages';

interface Props {
  page: ServicePage;
}

const { page } = Astro.props;
const primary = serviceById(page.services[0]!);
const path = `/${page.slug}`;
const site = Astro.site ?? Astro.url;
const phoneHref = `tel:${business.contact.phone}`;
const quote = '#quote-form';
const related = page.related.map((slug) => {
  const match = servicePages.find((p) => p.slug === slug);
  if (!match) throw new Error(`${page.slug}: unknown related service page "${slug}"`);
  return match;
});

const schema = [
  serviceSchema(
    { name: primary.name, description: page.description, path, serviceType: page.navLabel },
    site,
  ),
  breadcrumbSchema(
    [
      // Matches the visible breadcrumb: Home / Services / page.
      { name: 'Home', path: '/' },
      { name: 'Services', path: '/#services' },
      { name: page.navLabel, path },
    ],
    site,
  ),
  faqSchema(page.faqs),
];

const why = [
  {
    title: business.experience.label,
    text: 'More than fifteen years of looking after trees, hedges and gardens, so difficult jobs near homes and buildings are handled with confidence.',
  },
  {
    title: business.insurance.label,
    text: 'The work is fully insured, so you can have it done with peace of mind.',
  },
  {
    title: 'Free, clear quotations',
    text: 'You know what will be done, how it will be done and what it will cost before any work begins.',
  },
  {
    title: 'Tree care & landscaping',
    text: 'One team for trees, hedges, clearance and landscaping, from the first cut to the final tidy-up.',
  },
];
// Link-preview image for this page: its own hero photo, cropped to the
// 1.91:1 share shape, up to 1200×630 (never enlarged past the original).
const shareWidth = Math.min(1200, page.hero.image.src.width);
const shareHeight = Math.round(shareWidth / 1.905);
const shareImage = await getImage({
  src: page.hero.image.src,
  width: shareWidth,
  height: shareHeight,
  fit: 'cover',
  position: 'centre',
  format: 'jpg',
  quality: 80,
});
const imgWidths = (w: number) => [400, 640, 960, 1280, 1600].filter((x) => x <= w);
---

<PageLayout
  title={page.seoTitle}
  absoluteTitle
  description={page.description}
  image={{
    src: shareImage.src,
    alt: page.hero.image.alt,
    width: shareWidth,
    height: shareHeight,
  }}
  schema={schema}
  quoteLink={quote}
>
  {/* A. Hero */}
  <section class="svc-hero surface-dark" aria-labelledby="svc-title">
    <div class="svc-hero__media">
      <Picture
        src={page.hero.image.src}
        alt={page.hero.image.alt}
        widths={imgWidths(page.hero.image.src.width)}
        sizes="(min-width: 64em) 45vw, 100vw"
        formats={['avif', 'webp']}
        priority
        layout="none"
        style={page.hero.image.focus ? `object-position: ${page.hero.image.focus}` : undefined}
      />
      <span class="svc-hero__caption">{page.hero.image.caption}</span>
    </div>

    <div class="svc-hero__content">
      <nav aria-label="Breadcrumb" class="crumbs">
        <ol role="list">
          <li>
            <a href="/">Home</a>
          </li>
          <li>
            <a href="/#services">Services</a>
          </li>
          <li aria-current="page">{page.navLabel}</li>
        </ol>
      </nav>
      <p class="eyebrow">{page.hero.eyebrow}</p>
      <h1 id="svc-title" class="svc-hero__title">
        {`${page.hero.title} `}
        <em>{page.hero.accent}</em>
        {page.hero.end && ` ${page.hero.end}`}
      </h1>
      <p class="lead svc-hero__lead">{page.hero.intro}</p>
      <div class:list={['svc-hero__ctas', { 'svc-hero__ctas--call': page.hero.callFirst }]}>
        <Button
          href={quote}
          size="lg"
          arrow
          variant={page.hero.callFirst ? 'secondary' : 'primary'}
        >
          Request a free quote
        </Button>
        <Button href={phoneHref} variant={page.hero.callFirst ? 'primary' : 'secondary'} size="lg">
          Call {business.contact.phoneDisplay}
        </Button>
      </div>
      <TrustList class="svc-hero__trust" />
    </div>
  </section>

  {/* B. Introduction */}
  <section class="section-lg svc-intro" aria-labelledby="intro-title">
    <div class="container svc-intro__grid">
      <div class="svc-intro__text reveal">
        <h2 id="intro-title">
          {`${page.overview.title} `}
          <em>{page.overview.accent}</em>
          {page.overview.end && ` ${page.overview.end}`}
        </h2>
        {page.overview.paragraphs.map((p) => (
          <p>{p}</p>
        ))}
      </div>
      <aside class="svc-intro__panel surface-dark reveal" aria-labelledby="situations-title">
        <h3 id="situations-title">{page.overview.situationsTitle}</h3>
        <ul role="list">
          {page.overview.situations.map((s) => (
            <li>{s}</li>
          ))}
        </ul>
        <a class="svc-intro__call" href={phoneHref}>
          Not sure? Call {business.contact.phoneDisplay}
        </a>
      </aside>
    </div>
  </section>

  {/* C. Work we undertake */}
  <section class="section-lg surface-dark svc-work" aria-labelledby="work-title">
    <div class="container svc-stack">
      <SectionHeader id="work-title" eyebrow="What we do" split>
        <Fragment slot="title">
          {`${page.work.title} `}
          <em>{page.work.accent}</em>
          {page.work.end && ` ${page.work.end}`}
        </Fragment>
        <p>{page.work.intro}</p>
      </SectionHeader>
      <ol class="svc-work__list" role="list">
        {page.work.items.map((item, i) => (
          <li class="reveal">
            <span class="svc-n" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3>
              {item.href ? (
                <a class="svc-work__link" href={item.href}>
                  {item.title}
                  <span aria-hidden="true">→</span>
                </a>
              ) : (
                item.title
              )}
            </h3>
            <p>{item.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* D. Why Cawley's */}
  <section class="section-lg surface-accent texture svc-why" aria-labelledby="why-title">
    <div class="container svc-why__grid">
      <div class="svc-why__intro reveal">
        <p class="eyebrow">Why choose us</p>
        <h2 id="why-title">
          Why choose Cawley’s <em>Tree Care &amp; Landscaping?</em>
        </h2>
        <p class="lead">{page.why}</p>
        <div class="svc-why__actions">
          <Button href={quote} size="lg" arrow>
            Request a free quote
          </Button>
          <a class="svc-why__link" href="/#about">
            About Cawley’s
          </a>
        </div>
      </div>
      <ul class="svc-why__list" role="list">
        {why.map((w) => (
          <li class="reveal">
            <h3>{w.title}</h3>
            <p>{w.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* E. Photos */}
  <section class="section-lg surface-dark svc-photos" aria-labelledby="photos-title">
    <div class="container svc-stack">
      <SectionHeader id="photos-title" eyebrow="Our work" split>
        <Fragment slot="title">
          {`${page.photos.title} `}
          <em>{page.photos.accent}</em>
          {page.photos.end && ` ${page.photos.end}`}
        </Fragment>
        <p>{page.photos.intro}</p>
      </SectionHeader>
      <ul
        class:list={['svc-photos__grid', `svc-photos__grid--${page.photos.items.length}`]}
        role="list"
      >
        {page.photos.items.map((p) => (
          <li>
            <figure>
              <Picture
                src={p.src}
                alt={p.alt}
                widths={imgWidths(p.src.width)}
                sizes="(min-width: 64em) 40vw, (min-width: 48em) 50vw, 100vw"
                formats={['avif', 'webp']}
                layout="none"
                style={p.focus ? `object-position: ${p.focus}` : undefined}
              />
              <figcaption>{p.caption}</figcaption>
            </figure>
          </li>
        ))}
      </ul>
      <Button href="/#work" variant="secondary" arrow>
        See more of our work
      </Button>
    </div>
  </section>

  {/* F. How it works */}
  <section class="section-lg svc-process" aria-labelledby="process-title">
    <div class="container svc-stack">
      <SectionHeader id="process-title" eyebrow="How it works">
        <Fragment slot="title">
          {`${page.process.title} `}
          <em>{page.process.accent}</em>
          {page.process.end && ` ${page.process.end}`}
        </Fragment>
      </SectionHeader>
      <ol class="svc-process__steps" role="list">
        {page.process.steps.map((s, i) => (
          <li class="reveal">
            <span class="svc-process__n" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* G. Areas */}
  <HomeAreas lead={page.areas.replace(/\.$/, '')} quoteLink={quote} />

  {/* H. FAQs + related services */}
  <section class="section-lg svc-faq" aria-labelledby="faq-title">
    <div class="container svc-faq__grid">
      <div class="svc-faq__list">
        <SectionHeader id="faq-title" eyebrow="Questions">
          <Fragment slot="title">
            Frequently asked <em>questions</em>
          </Fragment>
        </SectionHeader>
        <div>
          {page.faqs.map((f) => (
            <details class="faq">
              <summary>
                <span class="faq__q">{f.question}</span>
                <span class="faq__icon" aria-hidden="true"></span>
              </summary>
              <p>{f.answer}</p>
            </details>
          ))}
        </div>
      </div>

      <nav class="svc-related" aria-labelledby="related-title">
        <h2 id="related-title" class="svc-related__title">
          Related services
        </h2>
        <ul role="list">
          {related.map((r) => (
            <li>
              <a href={`/${r.slug}`}>
                <span class="svc-related__name">{r.navLabel}</span>
                <span class="svc-related__teaser">{r.teaser}</span>
                <span class="svc-related__arrow" aria-hidden="true">
                  →
                </span>
              </a>
            </li>
          ))}
        </ul>
        <p class="svc-related__more">
          <a href="/#services">All services</a> · <a href="/#work">Our work</a> ·{' '}
          <a href="/#enquiry">Contact us</a>
        </p>
      </nav>
    </div>
  </section>

  {/* I. Final call to action */}
  <section class="svc-cta surface-accent texture" aria-labelledby="cta-title">
    <div class="container svc-cta__inner reveal">
      <h2 id="cta-title">
        {`${page.cta.title} `}
        <em>{page.cta.accent}</em>
        {page.cta.end && ` ${page.cta.end}`}
      </h2>
      <p class="lead">{page.cta.text}</p>
      <div class="svc-cta__actions">
        <Button href={phoneHref} size="lg">
          Call {business.contact.phoneDisplay}
        </Button>
        <Button href={quote} variant="secondary" size="lg" arrow>
          Request a free quote
        </Button>
      </div>
    </div>
  </section>

  <HomeEnquiry service={primary.name} />
</PageLayout>

<style>
  .svc-stack {
    display: grid;
    gap: var(--space-xl);
    justify-items: start;
  }

  .svc-stack > :global(*) {
    min-width: 0;
    width: 100%;
  }

  .svc-stack > :global(.btn) {
    width: auto;
  }

  .svc-n,
  .svc-process__n {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    color: var(--color-accent-text);
  }

  /* ---------- A. Hero ---------- */
  .svc-hero {
    display: grid;
    margin-block-start: calc(var(--header-height) * -1);
  }

  .svc-hero__media {
    position: relative;
    overflow: hidden;
    height: min(34svh, 18rem);
    margin-block-start: var(--header-height);
    background: var(--charcoal-800);
  }

  .svc-hero__media :global(picture),
  .svc-hero__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .svc-hero__media :global(img) {
    object-fit: cover;
  }

  .svc-hero__caption {
    position: absolute;
    inset: auto 0 0;
    padding: var(--space-xl) var(--gutter) var(--space-s);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    color: var(--ivory-100);
    background: linear-gradient(to top, rgb(17 17 17 / 0.8), rgb(17 17 17 / 0));
  }

  .svc-hero__content {
    display: grid;
    gap: var(--space-s);
    align-content: center;
    padding: var(--space-l) var(--gutter) var(--space-2xl);
  }

  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4em;
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .crumbs li + li::before {
    content: '/';
    margin-inline-end: 0.4em;
    color: var(--color-text-muted);
  }

  .crumbs a {
    color: var(--color-text-secondary);
    text-decoration: none;
  }

  .crumbs a:hover {
    color: var(--color-text);
  }

  .crumbs [aria-current] {
    color: var(--color-text);
  }

  .svc-hero__title {
    max-width: 13ch;
    font-size: clamp(2.5rem, 1.6rem + 4vw, 5rem);
    line-height: 1.02;
  }

  .svc-hero__lead {
    max-width: 44ch;
  }

  .svc-hero__ctas {
    display: grid;
    gap: var(--space-2xs);
    margin-block-start: var(--space-2xs);
  }

  .svc-hero__ctas :global(.btn) {
    justify-self: stretch;
  }

  /* Urgent pages: the call button comes first. */
  .svc-hero__ctas--call :global(.btn:last-child) {
    order: -1;
  }

  :global(.svc-hero__trust) {
    margin-block-start: var(--space-xs);
  }

  @media (min-width: 30em) {
    .svc-hero__ctas {
      grid-template-columns: auto auto;
      justify-content: start;
    }
  }

  @media (min-width: 64em) {
    .svc-hero {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      min-height: max(40rem, min(92svh, 56rem));
    }

    .svc-hero__media {
      order: 2;
      height: auto;
      margin-block-start: 0;
    }

    .svc-hero__caption {
      padding-inline: var(--space-l);
    }

    .svc-hero__content {
      padding: calc(var(--header-height) + var(--space-2xl)) clamp(2rem, 5vw, 5.5rem)
        var(--space-2xl) max(var(--gutter), calc((100vw - var(--container-max, 80rem)) / 2));
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .svc-hero__media :global(img) {
      animation: svc-settle 2.4s var(--ease-out) both;
    }

    .svc-hero__content > :global(*) {
      animation: svc-rise 0.9s var(--ease-out) both;
    }
  }

  @keyframes svc-settle {
    from {
      transform: scale(1.06);
    }
  }

  @keyframes svc-rise {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }
  }

  /* ---------- B. Introduction ---------- */
  .svc-intro__grid {
    display: grid;
    gap: var(--space-xl);
  }

  .svc-intro__text {
    display: grid;
    gap: var(--space-s);
    align-content: start;
  }

  .svc-intro__text h2 {
    font-size: var(--text-3xl);
    line-height: 1.08;
    max-width: 16ch;
    margin-block-end: var(--space-2xs);
  }

  .svc-intro__text p {
    max-width: 60ch;
    color: var(--color-text-secondary);
  }

  .svc-intro__text p:first-of-type {
    font-size: var(--text-lg);
    color: var(--color-text);
  }

  .svc-intro__panel {
    display: grid;
    gap: var(--space-s);
    align-content: start;
    padding: var(--space-l) var(--space-m);
  }

  .svc-intro__panel h3 {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-accent-text);
  }

  .svc-intro__panel ul {
    display: grid;
  }

  .svc-intro__panel li {
    display: flex;
    gap: 0.8em;
    align-items: baseline;
    padding-block: var(--space-2xs);
    border-block-end: 1px solid var(--color-border);
    max-width: none;
  }

  .svc-intro__panel li::before {
    content: '';
    flex-shrink: 0;
    width: 0.4rem;
    height: 0.4rem;
    background: var(--orange-500);
    transform: translateY(-0.15em) rotate(45deg);
  }

  .svc-intro__call {
    justify-self: start;
    min-height: var(--tap-target);
    display: inline-flex;
    align-items: center;
    font-weight: var(--weight-semibold);
    text-decoration-color: var(--orange-500);
    text-underline-offset: 0.25em;
  }

  @media (min-width: 64em) {
    .svc-intro__grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: var(--space-2xl);
      align-items: start;
    }

    .svc-intro__panel {
      padding: var(--space-xl) var(--space-l);
    }
  }

  /* ---------- C. Work ---------- */
  .svc-work__list {
    display: grid;
    gap: 0 var(--space-l);
  }

  .svc-work__list li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-3xs) var(--space-s);
    padding-block: var(--space-m);
    border-block-start: 1px solid var(--color-border);
    max-width: none;
  }

  .svc-work__list .svc-n {
    grid-row: span 2;
  }

  .svc-work__list h3 {
    font-size: var(--text-xl);
    line-height: 1.2;
  }

  .svc-work__link {
    text-decoration: none;
  }

  .svc-work__link span {
    display: inline-block;
    margin-inline-start: 0.35em;
    color: var(--orange-500);
    transition: transform var(--duration-base) var(--ease-out);
  }

  .svc-work__link:hover {
    text-decoration: underline;
    text-decoration-color: var(--orange-500);
    text-underline-offset: 0.2em;
  }

  .svc-work__link:hover span {
    transform: translateX(4px);
  }

  .svc-work__list p {
    color: var(--color-text-secondary);
    max-width: 44ch;
  }

  @media (min-width: 48em) {
    .svc-work__list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 72em) {
    .svc-work__list {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* ---------- D. Why ---------- */
  .svc-why__grid {
    display: grid;
    gap: var(--space-xl);
  }

  .svc-why__intro {
    display: grid;
    gap: var(--space-s);
    align-content: start;
  }

  .svc-why__intro h2 {
    font-size: var(--text-3xl);
    line-height: 1.08;
    max-width: 14ch;
  }

  .svc-why__intro .lead {
    max-width: 40ch;
  }

  .svc-why__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-s) var(--space-m);
    margin-block-start: var(--space-xs);
  }

  .svc-why__link {
    font-weight: var(--weight-semibold);
    text-underline-offset: 0.25em;
    min-height: var(--tap-target);
    display: inline-flex;
    align-items: center;
  }

  .svc-why__list {
    display: grid;
    border-block-start: 1px solid var(--color-border);
  }

  .svc-why__list li {
    display: grid;
    gap: var(--space-3xs);
    padding-block: var(--space-m);
    border-block-end: 1px solid var(--color-border);
    max-width: none;
  }

  .svc-why__list h3 {
    font-size: var(--text-2xl);
    line-height: 1.15;
  }

  @media (min-width: 64em) {
    .svc-why__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: var(--space-2xl);
    }
  }

  /* ---------- E. Photos ---------- */
  .svc-photos__grid {
    display: grid;
    gap: var(--space-3xs);
  }

  .svc-photos__grid li {
    max-width: none;
  }

  .svc-photos__grid figure {
    position: relative;
    overflow: hidden;
    height: 100%;
    aspect-ratio: 4 / 3;
    background: var(--charcoal-700);
  }

  .svc-photos__grid :global(picture),
  .svc-photos__grid :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .svc-photos__grid :global(img) {
    object-fit: cover;
    transition: transform 900ms var(--ease-out);
  }

  .svc-photos__grid figure:hover :global(img) {
    transform: scale(1.035);
  }

  .svc-photos__grid figcaption {
    position: absolute;
    inset: auto 0 0;
    padding: var(--space-xl) var(--space-s) var(--space-s);
    font-size: var(--text-sm);
