---
/**
 * Template for future dedicated service pages (e.g. /tree-surgery).
 * Not used yet: no service pages are published until each has genuinely
 * useful, unique content. See docs/SERVICE-PAGES.md.
 *
 * Gives every service page the same premium structure:
 * photo hero → breadcrumbs → body (slot) → FAQs → quote call to action,
 * plus its own title, description, Service, BreadcrumbList and FAQPage
 * structured data.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import PageLayout from '@/layouts/PageLayout.astro';
import Button from '@/components/ui/Button.astro';
import HomeEnquiry from '@/components/home/HomeEnquiry.astro';
import { breadcrumbSchema, faqSchema, serviceSchema } from '@/lib/schema';
import { business } from '@/config/business';
import type { Service } from '@/config/services';

interface Props {
  service: Service;
  /** ≤60 characters, unique to this page. */
  seoTitle: string;
  /** 50–160 characters, unique to this page. */
  description: string;
  heading: string;
  intro: string;
  image: { src: ImageMetadata; alt: string; focus?: string };
  faqs?: { question: string; answer: string }[];
}

const { service, seoTitle, description, heading, intro, image, faqs = [] } = Astro.props;
const site = Astro.site ?? Astro.url;
const schema = [
  serviceSchema({ name: service.name, description, path: service.path }, site),
  breadcrumbSchema(
    [
      { name: 'Home', path: '/' },
      { name: service.name, path: service.path },
    ],
    site,
  ),
  ...(faqs.length ? [faqSchema(faqs)] : []),
];
---

<PageLayout title={seoTitle} description={description} schema={schema}>
  <section class="svc-hero surface-dark">
    <div class="svc-hero__media">
      <Picture
        src={image.src}
        alt={image.alt}
        widths={[640, 960, 1280, 1600].filter((w) => w <= image.src.width)}
        sizes="100vw"
        formats={['avif', 'webp']}
        priority
        layout="none"
        style={image.focus ? `object-position: ${image.focus}` : undefined}
      />
    </div>
    <div class="container svc-hero__content">
      <nav aria-label="Breadcrumb" class="crumbs">
        <a href="/">Home</a> <span aria-hidden="true">/</span>{' '}
        <span aria-current="page">{service.name}</span>
      </nav>
      <h1>{heading}</h1>
      <p class="lead">{intro}</p>
      <div class="cluster">
        <Button href="#quote-form" size="lg" arrow>
          Request a free quote
        </Button>
        <Button href={`tel:${business.contact.phone}`} variant="secondary" size="lg">
          Call {business.contact.phoneDisplay}
        </Button>
      </div>
    </div>
  </section>

  <div class="section container container-prose prose">
    <slot />
  </div>

  {faqs.length > 0 && (
    <section class="section container container-prose" aria-labelledby="faq-title">
      <h2 id="faq-title">Common questions</h2>
      {faqs.map((f) => (
        <details class="faq">
          <summary>{f.question}</summary>
          <p>{f.answer}</p>
        </details>
      ))}
    </section>
  )}

  <HomeEnquiry />
</PageLayout>

<style>
  .svc-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    margin-block-start: calc(var(--header-height) * -1);
  }

  .svc-hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .svc-hero__media :global(picture),
  .svc-hero__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .svc-hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, rgb(17 17 17 / 0.9), rgb(17 17 17 / 0.45));
  }

  .svc-hero__content {
    display: grid;
    gap: var(--space-m);
    padding-block: calc(var(--header-height) + var(--space-2xl)) var(--space-2xl);
  }

  .svc-hero h1 {
    max-width: 14ch;
  }

  .crumbs {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .faq {
    padding-block: var(--space-s);
    border-block-end: 1px solid var(--color-border);
  }

  .faq summary {
    cursor: pointer;
    font-weight: var(--weight-semibold);
  }

  .faq p {
    margin-block-start: var(--space-2xs);
    color: var(--color-text-secondary);
  }
</style>
