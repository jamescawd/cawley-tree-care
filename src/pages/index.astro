---
/**
 * Homepage (Stage 1). Sets the design standard for the whole site.
 * Section order follows the brief: services first (tree care leading),
 * then trust, work, about, areas, reviews and the enquiry form.
 */
import PageLayout from '@/layouts/PageLayout.astro';
import HomeHero from '@/components/home/HomeHero.astro';
import HomeTreeCare from '@/components/home/HomeTreeCare.astro';
import HomeLandscaping from '@/components/home/HomeLandscaping.astro';
import HomeWhy from '@/components/home/HomeWhy.astro';
import HomeWork from '@/components/home/HomeWork.astro';
import HomeAbout from '@/components/home/HomeAbout.astro';
import HomeAreas from '@/components/home/HomeAreas.astro';
import HomeTestimonials from '@/components/home/HomeTestimonials.astro';
import HomeEnquiry from '@/components/home/HomeEnquiry.astro';
import { media } from '@/config/media';
import { getImage } from 'astro:assets';

const shareImage = await getImage({ src: media.homeHero.src, width: 1200, format: 'jpg' });
---

<PageLayout
  title="Cawley's Tree Care & Landscaping | Tree Surgery, Midlands & West"
  absoluteTitle
  description="Professional tree care, tree surgery and landscaping across Westmeath, Roscommon, Longford, Offaly and Galway. Over 15 years' experience. Fully insured."
  image={{ src: shareImage.src, alt: media.homeHero.alt, width: 1200, height: 673 }}
>
  <HomeHero />
  <HomeTreeCare />
  <HomeLandscaping />
  <HomeWhy />
  <HomeWork />
  <HomeAbout />
  <HomeAreas />
  <HomeTestimonials />
  <HomeEnquiry />
</PageLayout>
