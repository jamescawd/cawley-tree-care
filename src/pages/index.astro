---
/**
 * Homepage (Stage 1). Sets the design standard for the whole site.
 * Section order follows the brief: services first (tree care leading),
 * then trust, work, about, areas, reviews and the enquiry form.
 */
import PageLayout from '@/layouts/PageLayout.astro';
import HomeHero from '@/components/home/HomeHero.astro';
import HomeTrust from '@/components/home/HomeTrust.astro';
import HomeServices from '@/components/home/HomeServices.astro';
import HomeWhy from '@/components/home/HomeWhy.astro';
import HomeProcess from '@/components/home/HomeProcess.astro';
import HomeWork from '@/components/home/HomeWork.astro';
import HomeAbout from '@/components/home/HomeAbout.astro';
import HomeAreas from '@/components/home/HomeAreas.astro';
import HomeTestimonials from '@/components/home/HomeTestimonials.astro';
import HomeEnquiry from '@/components/home/HomeEnquiry.astro';
import Marquee from '@/components/ui/Marquee.astro';
import { serviceAreas } from '@/config/areas';

const places = serviceAreas.flatMap((a) => [`Co. ${a.county as string}`, ...(a.towns as string[])]);
---

<PageLayout
  title="Cawley's Tree Care & Landscaping | Tree Surgeons, Athlone"
  absoluteTitle
  description="Tree surgery, tree removal, hedge cutting, storm damage, garden clearance and landscaping in Westmeath, Roscommon, Longford, Offaly and Galway. Fully insured."
  image={{
    src: '/og-image.jpg',
    alt: "Cawley's Tree Care & Landscaping logo over a photo of storm clearance work",
    width: 1200,
    height: 630,
  }}
>
  <HomeHero />
  <HomeTrust />
  <HomeServices />
  <HomeWork />
  <HomeWhy />
  <HomeProcess />
  <HomeAbout />
  <Marquee items={places} duration={90} />
  <HomeAreas />
  <HomeTestimonials />
  <HomeEnquiry />
</PageLayout>
