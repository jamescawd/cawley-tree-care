# Copy to .env for local overrides. In production, set these in
# Cloudflare Pages → Settings → Environment variables.

# Canonical origin of the live site, no trailing slash.
# Leave unset until the domain is confirmed; local builds fall back to localhost.
SITE_URL=

# Search-engine indexing master switch. Anything other than "true" adds
# `noindex` to every page and a `Disallow: /` robots.txt.
# Set to "true" ONLY for the production deployment at launch.
ALLOW_INDEXING=false
